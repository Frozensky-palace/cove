---
/**
 * 首页（指南 9.2）：作者是谁、写什么、从哪里开始读。
 * 结构：Hero（360–440px）→ 从这里开始（编辑策划，空则隐藏）→
 * 精选文章（1 重点 + 2 条目）→ 最新文章 → 最近笔记 → 代表项目。
 * 区块无内容时整体隐藏，全部为空时给空状态。IMPL-056：条目精简
 * 与「查看全部」无障碍名、Hero 定位语句（评审报告 4.4）。
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/base/Button.astro';
import HomeSection from '@/components/home/HomeSection.astro';
import ArticleCard from '@/components/content/ArticleCard.astro';
import ArticleListItem from '@/components/content/ArticleListItem.astro';
import NoteListItem from '@/components/content/NoteListItem.astro';
import ProjectCard from '@/components/content/ProjectCard.astro';
import EmptyState from '@/components/content/EmptyState.astro';
import CompassIcon from '@/components/base/icons/CompassIcon.astro';
import StarIcon from '@/components/base/icons/StarIcon.astro';
import ClockIcon from '@/components/base/icons/ClockIcon.astro';
import PenLineIcon from '@/components/base/icons/PenLineIcon.astro';
import AnchorIcon from '@/components/base/icons/AnchorIcon.astro';
import { siteConfig } from '@/data/site';
import {
  getFeaturedPosts,
  getPublishedPosts,
  getPublishedNotes,
  getPublishedProjects,
} from '@/lib/content';

const featured = await getFeaturedPosts(3);
const featuredMain = featured[0];
const featuredRest = featured.slice(1, 3);

// 最新文章排除已在精选区出现的条目，避免首页重复。
// IMPL-056：5 → 4 篇（评审报告 4.4：首页是编辑过的首页，不是内容数据库）
const featuredIds = new Set(featured.map((post) => post.id));
const latestPosts = (await getPublishedPosts()).filter((post) => !featuredIds.has(post.id)).slice(0, 4);

const recentNotes = (await getPublishedNotes()).slice(0, 3);
const featuredProjects = (await getPublishedProjects()).slice(0, 2);

/**
 * 「从这里开始」（评审报告 4.4 → IMPL-056）：最能代表作者的 3 篇内容。
 * 填文章 id（src/content/posts/ 下的文件名去扩展名），留空则整节隐藏——
 * 不用测试内容凑数，等真实定稿文章就位后由站长编辑本列表。
 */
const START_HERE_IDS: string[] = [];

const allPosts = await getPublishedPosts();
const startHere = START_HERE_IDS.map((id) => allPosts.find((post) => post.id === id)).filter(
  (post): post is NonNullable<typeof post> => Boolean(post),
);

const hasContent =
  featured.length > 0 || latestPosts.length > 0 || recentNotes.length > 0 || featuredProjects.length > 0;
---

<BaseLayout title={siteConfig.name} description={siteConfig.tagline} path="/">
  <section class="hero">
    <div class="cove-container hero-grid">
      <div class="hero-copy">
        <!-- Display 层级：全站最多一处（指南 8.3） -->
        <h1 class="hero-title">你好，这里是 <span class="hero-name">Cove</span></h1>
        <!-- 定位语句（IMPL-056 草稿；评审 L01 收敛文字量——320px 下六行介绍
             把首卡推出首屏，深入说明留给关于页；措辞待站长定稿） -->
        <p class="hero-description">
          长文讲透一件事，笔记留住一个念头——在这里记录学习心得、思考过程与实践复盘。
        </p>
        <div class="hero-actions">
          <Button href="/posts/" variant="primary">阅读文章</Button>
          <Button href="/about/" variant="secondary">了解 Cove</Button>
        </div>
      </div>
      <!-- 品牌标志图（插画卡片逐列描摹抠底，IMPL-037）：仅 ≥768px 显示。
           Phase 8.2（设计见 docs/COVE-SHORT-STORY-DESIGN.md 第 5 节）：整张
           品牌卡成为指向短篇集 /story/ 的链接（IMPL-083 书架化：泛指入口
           落书架页），名称由 aria-label 承担，图片保持空 alt 纯装饰；
           移除原 aria-hidden 父级，避免连链接一起隐藏。
           卡片外区域（含贴边软投影）已在 WebP 内烘焙为透明；投影用 drop-shadow 按形状投射 -->
      <a class="hero-brand" href="/story/" aria-label="翻开海湾短篇">
        <img
          src="/home-brand.webp"
          alt=""
          width="430"
          height="449"
          loading="eager"
          decoding="async"
        />
      </a>
    </div>
  </section>

  <div class="cove-container">
    {
      hasContent ? (
        <>
          {startHere.length > 0 && (
            <HomeSection title="从这里开始" label="从这里开始" icon={CompassIcon}>
              <div class="latest-list">
                {startHere.map((post) => (
                  <ArticleListItem post={post} />
                ))}
              </div>
            </HomeSection>
          )}

          {featured.length > 0 && (
            <HomeSection title="精选文章" icon={StarIcon} moreHref="/posts/" moreAriaLabel="查看全部文章">
              <div class="featured-grid">
                {featuredMain && <ArticleCard post={featuredMain} emphasis />}
                {featuredRest.length > 0 && (
                  <div class="featured-side">
                    {featuredRest.map((post) => (
                      <ArticleCard post={post} />
                    ))}
                  </div>
                )}
              </div>
            </HomeSection>
          )}

          {latestPosts.length > 0 && (
            <HomeSection title="最新文章" icon={ClockIcon} moreHref="/posts/" moreAriaLabel="查看全部文章">
              <div class="latest-list">
                {latestPosts.map((post) => (
                  <ArticleListItem post={post} />
                ))}
              </div>
            </HomeSection>
          )}

          {recentNotes.length > 0 && (
            <HomeSection title="最近笔记" icon={PenLineIcon} moreHref="/notes/" moreAriaLabel="查看全部笔记">
              <div class="notes-list">
                {recentNotes.map((note) => (
                  <NoteListItem note={note} />
                ))}
              </div>
            </HomeSection>
          )}

          {featuredProjects.length > 0 && (
            <HomeSection title="代表项目" icon={AnchorIcon} moreHref="/projects/" moreAriaLabel="查看全部项目">
              <div class="projects-list">
                {featuredProjects.map((project) => (
                  <ProjectCard project={project} />
                ))}
              </div>
            </HomeSection>
          )}
        </>
      ) : (
        <EmptyState
          title="内容还在海湾里酝酿"
          description="文章、笔记与项目正在整理中，先看看设计系统展示页，或稍后再来。"
        >
          <Button href="/dev/" variant="secondary" slot="actions">
            设计系统展示
          </Button>
          <Button href="/posts/" variant="ghost" slot="actions">
            浏览文章
          </Button>
        </EmptyState>
      )
    }
  </div>
</BaseLayout>

<style>
  /* 首屏高度：桌面 360–440px（指南 9.2），矮视口（小手机横竖屏）按视口收缩；
     下限 320→280（评审 L01）：短屏上不为「居中感」垫高空区 */
  .hero {
    display: flex;
    align-items: center;
    min-height: clamp(280px, 52vh, 440px);
    padding-block: 3rem;
  }

  /* 品牌图在文案列右侧；<768px 无「右侧」语义，隐藏保持首屏紧凑 */
  .hero-grid {
    display: flex;
    flex-direction: column;
  }

  .hero-brand {
    display: none;
  }

  @media (min-width: 768px) {
    .hero-grid {
      display: grid;
      grid-template-columns: minmax(0, 1fr) auto;
      align-items: center;
      gap: 2.5rem;
    }

    .hero-brand {
      display: block;
      align-self: center;
      /* 裁切后插画不再自带四周底色（IMPL-036），内收一点避免贴住版心右缘 */
      margin-inline-end: clamp(0rem, 1.5vw, 1rem);
      /* 入场：淡入 + 上浮（用户点名动效；reduced-motion 下由全局规则关闭） */
      animation: brand-in 560ms var(--ease-out) both;
    }

    .hero-brand img {
      display: block;
      width: clamp(200px, 22vw, 288px);
      height: auto;
      /* 卡片外区域已在 WebP 内烘焙为透明（IMPL-037），无需圆角裁切；
         投影用 drop-shadow 按 alpha 形状投射——box-shadow 只能是矩形，
         且原图卡片底部是 squircle 曲线，几何圆角无法贴合 */
      filter: drop-shadow(0 24px 32px color-mix(in srgb, var(--cove-blue-strong) 32%, transparent))
        drop-shadow(0 8px 14px color-mix(in srgb, var(--cove-blue-strong) 22%, transparent));
      /* 评审 M02：常驻漂浮收敛——保留悬停反馈与入场（见 .hero-brand），
         移除 7s 循环上下漂浮：阅读为主的页面，文字旁的持续运动是
         常驻注意力竞争者；若日后证实品牌需要，再以更轻的幅度回归 */
      transition:
        scale 240ms var(--ease-standard),
        filter 240ms var(--ease-standard);
    }

    .hero-brand:hover img {
      scale: 1.025;
      filter: drop-shadow(0 30px 40px color-mix(in srgb, var(--cove-blue-strong) 40%, transparent))
        drop-shadow(0 10px 18px color-mix(in srgb, var(--cove-blue-strong) 26%, transparent));
    }

    /* 深色模式：深色投影（浮在暗面上的卡片），悬停同步加深 */
    :global(.dark) .hero-brand img {
      filter: drop-shadow(0 24px 32px rgb(0 0 0 / 0.62)) drop-shadow(0 8px 14px rgb(0 0 0 / 0.46));
    }

    :global(.dark) .hero-brand:hover img {
      filter: drop-shadow(0 30px 40px rgb(0 0 0 / 0.68)) drop-shadow(0 10px 18px rgb(0 0 0 / 0.52));
    }
  }

  @keyframes brand-in {
    from {
      opacity: 0;
      transform: translateY(14px);
    }

    to {
      opacity: 1;
      transform: none;
    }
  }

  @media (min-width: 1024px) {
    .hero-grid {
      gap: 4rem;
    }
  }

  .hero-title {
    margin: 0;
    font-size: clamp(2.25rem, 5vw, 3.5rem); /* 36px → 56px */
    font-weight: 700;
    letter-spacing: 0.01em;
    line-height: 1.25;
  }

  .hero-name {
    /* 品牌名允许使用蓝粉渐变这一处关键视觉（指南 8.2） */
    background: linear-gradient(120deg, var(--cove-blue-strong), var(--shell-pink));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  .hero-description {
    max-width: 40rem;
    margin-top: 1.25rem;
    color: var(--text-muted);
    font-size: 17px;
    line-height: 1.9;
  }

  .hero-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-top: 2rem;
  }

  /* 评审 L01：窄屏收敛 Hero 纵向节奏——padding 与间距收窄、描述字号随全站
     窄屏 16px 基准（行高保持宽松不压缩），让「精选文章」与首卡更早进入首屏 */
  @media (max-width: 767px) {
    .hero {
      padding-block: 2rem;
    }

    .hero-description {
      margin-top: 1rem;
      font-size: 16px;
      line-height: 1.85;
    }

    .hero-actions {
      margin-top: 1.5rem;
    }
  }

  /* 精选：重点卡片 + 两个紧凑条目；窄屏纵向堆叠。
     minmax(0, …) 防止不可断长内容撑破列（响应式审查 #9） */
  .featured-grid {
    display: grid;
    gap: 1rem;
  }

  .featured-side {
    display: grid;
    gap: 1rem;
  }

  @media (min-width: 960px) {
    .featured-grid {
      grid-template-columns: minmax(0, 1.55fr) minmax(0, 1fr);
      align-items: start;
    }
  }

  .latest-list {
    max-width: 46rem;
  }

  .notes-list {
    max-width: 46rem;
  }

  .projects-list {
    display: grid;
    gap: 1rem;
    max-width: 46rem;
  }
</style>
