---
/**
 * 组件与设计令牌展示页（Phase 1 交付物，IMPL-007）。
 * 始终 noindex，不进入任何搜索索引；仅用于开发与视觉验收。
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/base/Button.astro';
import IconButton from '@/components/base/IconButton.astro';
import Tag from '@/components/base/Tag.astro';
import Divider from '@/components/base/Divider.astro';
import SearchIcon from '@/components/base/icons/SearchIcon.astro';
import RssIcon from '@/components/base/icons/RssIcon.astro';

const colorTokens: Array<{ name: string; usage: string }> = [
  { name: 'background', usage: '页面背景' },
  { name: 'surface', usage: '浮层与少量卡片' },
  { name: 'surface-muted', usage: '次级区块背景' },
  { name: 'text', usage: '主文字' },
  { name: 'text-muted', usage: '摘要与元信息' },
  { name: 'border', usage: '分隔线与输入框' },
  { name: 'cove-blue', usage: '品牌主色' },
  { name: 'cove-blue-strong', usage: '链接、焦点与选中态' },
  { name: 'shell-pink', usage: '小面积点缀' },
  { name: 'shell-pink-soft', usage: '柔和状态背景' },
  { name: 'focus', usage: '键盘焦点环' },
];
---

<BaseLayout
  title="组件与设计令牌"
  description="Cove 设计令牌与基础组件展示页（开发用，noindex）。"
  path="/dev/"
  noindex
>
  <div class="cove-container dev-page">
    <header class="dev-header">
      <h1>组件与设计令牌</h1>
      <p>
        开发与视觉验收用展示页，已设置 <code>noindex</code>。
        切换右上角主题按钮，可核对浅色与深色两套令牌（指南 8.2）。
      </p>
    </header>

    <section aria-labelledby="tokens-heading">
      <h2 id="tokens-heading">色彩令牌</h2>
      <ul class="swatches">
        {
          colorTokens.map(({ name, usage }) => (
            <li class="swatch">
              <span class="swatch-color" style={`background: var(--${name})`} aria-hidden="true" />
              <span class="swatch-name">{name}</span>
              <span class="swatch-usage">{usage}</span>
            </li>
          ))
        }
      </ul>
    </section>

    <section aria-labelledby="type-heading">
      <h2 id="type-heading">排版</h2>
      <div class="type-samples">
        <h3>H3 子章节 21–24px</h3>
        <p>
          正文 Body 17–18px，中文行高 1.8–1.9。海湾是安静的，文字也应当有足够的呼吸感；
          留白不是浪费，而是让每一段内容都能被从容阅读。
        </p>
        <p class="sample-meta">Meta 12–14px：日期、标签与辅助信息使用 text-muted。</p>
        <p>
          行内代码 <code>npm run dev</code>，等宽字体
          <span class="sample-mono">ui-monospace, SFMono-Regular, Consolas</span>。
        </p>
        <ul>
          <li>列表项一：4px 基础网格，常用间距 8 / 12 / 16 / 24 / 32 / 48 / 64 / 96px。</li>
          <li>列表项二：正文容器建议 680–760px，页面最大宽度 1200px。</li>
        </ul>
        <blockquote>
          引用样式：普通内容主要使用分隔线和留白建立层级，阴影只用于浮层、菜单和少量重点内容。
        </blockquote>
      </div>
    </section>

    <section aria-labelledby="button-heading">
      <h2 id="button-heading">Button</h2>
      <div class="demo-row">
        <Button variant="primary">主要按钮</Button>
        <Button variant="secondary">次要按钮</Button>
        <Button variant="ghost">幽灵按钮</Button>
        <Button variant="primary" href="https://example.com" target="_blank">链接按钮</Button>
        <Button variant="secondary" size="sm">小号 sm</Button>
        <Button variant="secondary" size="lg">大号 lg</Button>
      </div>
    </section>

    <section aria-labelledby="icon-button-heading">
      <h2 id="icon-button-heading">IconButton 与图标</h2>
      <div class="demo-row">
        <IconButton label="搜索"><SearchIcon size={18} /></IconButton>
        <IconButton label="RSS 订阅" href="/rss.xml"><RssIcon size={18} /></IconButton>
        <span class="demo-note">16px：<SearchIcon size={16} /></span>
        <span class="demo-note">18px：<SearchIcon size={18} /></span>
        <span class="demo-note">20px：<SearchIcon size={20} /></span>
      </div>
    </section>

    <section aria-labelledby="tag-heading">
      <h2 id="tag-heading">Tag</h2>
      <div class="demo-row">
        <Tag>Astro</Tag>
        <Tag>TypeScript</Tag>
        <Tag tone="pink">随笔</Tag>
        <Tag href="/tags/astro/">可点击标签</Tag>
      </div>
    </section>

    <section aria-labelledby="divider-heading">
      <h2 id="divider-heading">Divider</h2>
      <p>上一段内容。</p>
      <Divider />
      <p>分隔线之后的下一段内容。</p>
    </section>
  </div>
</BaseLayout>

<style>
  .dev-page {
    padding-block: 3rem 4rem;
  }

  .dev-header h1 {
    margin: 0;
    font-size: 2rem;
    font-weight: 700;
  }

  .dev-header p {
    max-width: 44rem;
    margin-top: 0.75rem;
    color: var(--text-muted);
    font-size: 15px;
    line-height: 1.8;
  }

  section {
    margin-top: 3rem;
  }

  section h2 {
    margin: 0 0 1.25rem;
    font-size: 1.375rem;
    font-weight: 700;
  }

  .swatches {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(200px, 1fr));
    gap: 0.875rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .swatch {
    display: grid;
    grid-template-columns: auto 1fr;
    grid-template-rows: auto auto;
    column-gap: 0.75rem;
    align-items: center;
    padding: 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    background-color: var(--surface);
  }

  .swatch-color {
    grid-row: 1 / span 2;
    width: 44px;
    height: 44px;
    border: 1px solid var(--border);
    border-radius: 8px;
  }

  .swatch-name {
    font-family: var(--font-mono);
    font-size: 13px;
    color: var(--text);
  }

  .swatch-usage {
    font-size: 12px;
    color: var(--text-muted);
  }

  .type-samples {
    max-width: 44rem;
  }

  .type-samples h3 {
    margin: 1.5rem 0 0.75rem;
    font-size: 1.375rem;
    font-weight: 700;
  }

  .type-samples p {
    margin: 0.75rem 0;
    font-size: 17px;
    line-height: 1.85;
  }

  .type-samples ul {
    margin: 0.75rem 0;
    padding-left: 1.5rem;
    line-height: 1.9;
  }

  .type-samples blockquote {
    margin: 1.25rem 0;
    padding: 0.25rem 0 0.25rem 1rem;
    border-left: 3px solid var(--cove-blue);
    color: var(--text-muted);
  }

  .sample-meta {
    font-size: 13px;
    color: var(--text-muted);
  }

  .sample-mono,
  code {
    font-family: var(--font-mono);
    font-size: 0.9em;
    padding: 0.125rem 0.375rem;
    border-radius: 6px;
    background-color: var(--surface-muted);
  }

  .demo-row {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.875rem;
  }

  .demo-note {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--text-muted);
    font-size: 13px;
  }
</style>
