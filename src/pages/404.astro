---
/**
 * 404 页面（Phase 1 空壳）：“走出海湾 / 迷航”轻量文案，
 * 提供首页、文章、搜索三个明确出口（指南 9.8）。
 * 彩蛋（IMPL-052，用户需求）：深夜（22:00–6:00）访问，或路径哈希命中
 * 1/8 概率时，标题切换为「站长外出散步了」。is:inline 无依赖渐进增强，
 * 无 JS 或未命中时保持默认文案。IMPL-083：深夜档顺势追加一句指向
 * 海湾短篇《靠岸之前》——彩蛋指认彩蛋，未命中时不出现在页面上。
 */
import BaseLayout from '@/layouts/BaseLayout.astro';
import Button from '@/components/base/Button.astro';
---

<BaseLayout
  title="迷航了"
  description="这片海域没有你要找的港湾。返回首页、浏览文章或使用搜索找到方向。"
  path="/404"
>
  <section class="cove-container lost">
    <p class="lost-code" aria-hidden="true">404</p>
    <h1 class="lost-title">迷航了</h1>
    <p class="lost-description">
      这片海域没有你要找的港湾。也许它已随潮水移动，从下面这些方向重新出发吧。
    </p>
    <div class="lost-actions">
      <Button href="/" variant="primary">回到首页</Button>
      <Button href="/posts/" variant="secondary">浏览文章</Button>
      <Button href="/search/" variant="ghost">使用搜索</Button>
    </div>
  </section>

  <script is:inline>
    (function () {
      var hour = new Date().getHours();
      var hash = 0;
      var path = location.pathname;
      for (var i = 0; i < path.length; i++) hash = (hash * 31 + path.charCodeAt(i)) >>> 0;
      /* 触发条件：深夜时段必触发；其余时段每 1/8 的路径命中 */
      if (hour >= 22 || hour < 6 || hash % 8 === 0) {
        var title = document.querySelector('.lost-title');
        var desc = document.querySelector('.lost-description');
        if (title) title.textContent = '站长外出散步了';
        if (desc) {
          desc.textContent =
            '灯塔暂时没人值守——晚风、潮汐和这片 404 都归站长管。TA 沿着海岸线散步去了，天亮前会回来。先从下面的路标回湾吧。';
        }
        document.title = document.title.replace('迷航了', '站长外出散步了');
        var story = document.createElement('p');
        story.className = 'lost-story';
        story.textContent = '趁灯塔没人值守，湾里那则夜航短篇正适合翻开——';
        var link = document.createElement('a');
        link.href = '/story/before-landing/';
        link.textContent = '《靠岸之前》';
        story.appendChild(link);
        if (desc && desc.parentNode) desc.parentNode.insertBefore(story, desc.nextSibling);
      }
    })();
  </script>
</BaseLayout>

<style>
  .lost {
    display: flex;
    flex-direction: column;
    align-items: flex-start;
    /* 覆盖 .cove-container 的 1200px：内容列收窄并居中（未分层规则优先于 @layer） */
    max-width: 40rem;
    padding-block: 6rem 4rem;
  }

  .lost-code {
    margin: 0;
    color: var(--cove-blue);
    font-family: var(--font-mono);
    font-size: 15px;
    letter-spacing: 0.2em;
  }

  .lost-title {
    margin: 0.75rem 0 0;
    font-size: clamp(2rem, 4vw, 2.75rem); /* 32px → 44px */
    font-weight: 700;
  }

  .lost-description {
    max-width: 34rem;
    margin-top: 1rem;
    color: var(--text-muted);
    font-size: 16px;
    line-height: 1.9;
  }

  /* 深夜档短篇指引（IMPL-083）：比正文小一号的旁注，链接站点强调色 */
  .lost-story {
    max-width: 34rem;
    margin: 0.875rem 0 0;
    color: var(--text-muted);
    font-size: 15px;
    line-height: 1.9;
  }

  .lost-story a {
    color: var(--cove-blue-strong);
    text-underline-offset: 0.25em;
  }

  .lost-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.875rem;
    margin-top: 2rem;
  }
</style>
