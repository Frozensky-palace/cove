---
/**
 * 归档页（指南 7.2「按年份和月份归档」）：时间轴形式——
 * 左侧竖线贯穿全页，年份为品牌色节点，条目带月-日与悬停点亮；
 * 纯 CSS 无 JS，普通链接可直达（渐进增强）。
 */
import ContentLayout from '@/layouts/ContentLayout.astro';
import { categoryLabel } from '@/data/taxonomy';
import { groupPostsByYear } from '@/lib/content';
import { postUrl } from '@/lib/urls';

const groups = await groupPostsByYear();
const total = groups.reduce((sum, group) => sum + group.posts.length, 0);

/** ISO 日期串（YYYY-MM-DD）→ 紧凑月-日（MM-DD），年份由时间轴节点承担 */
const monthDay = (dateString: string): string => dateString.slice(5);
---

<ContentLayout
  title="归档"
  description={`按年份归档的全部文章，共 ${total} 篇。`}
  path="/archive/"
  heading="归档"
  intro={`共 ${total} 篇文章，按发布年份倒序排列。`}
>
  {
    groups.length > 0 ? (
      <div class="timeline">
        {groups.map(({ year, posts }) => (
          <section class="tl-year" aria-labelledby={`year-${year}`}>
            <h2 class="tl-year-title" id={`year-${year}`}>
              {year}
              <span class="tl-year-count">（{posts.length} 篇）</span>
            </h2>
            <ul class="tl-list">
              {posts.map((post) => (
                <li>
                  <a class="tl-item" href={postUrl(post.id)}>
                    <time datetime={post.data.publishedAt}>
                      {monthDay(post.data.publishedAt)}
                    </time>
                    <span class="tl-title">{post.data.title}</span>
                    <span class="tl-category">{categoryLabel(post.data.category)}</span>
                  </a>
                </li>
              ))}
            </ul>
          </section>
        ))}
      </div>
    ) : (
      <p class="archive-empty">还没有已发布的文章。</p>
    )
  }
</ContentLayout>

<style>
  /* 时间轴几何：竖线中心 x = 6px（left 5px + 线宽 2px 的一半），
     年份节点与条目节点的圆心都对齐到它 */
  .timeline {
    position: relative;
    max-width: 46rem;
  }

  .timeline::before {
    content: '';
    position: absolute;
    left: 5px;
    top: 8px;
    bottom: 8px;
    width: 2px;
    border-radius: 1px;
    background-color: var(--border);
  }

  .tl-year {
    margin-bottom: 2.75rem;
  }

  .tl-year:last-child {
    margin-bottom: 0;
  }

  .tl-year-title {
    position: relative;
    margin: 0 0 0.75rem;
    padding-left: 2rem;
    font-size: 1.375rem;
    font-weight: 700;
    line-height: 1.4;
  }

  .tl-year-count {
    color: var(--text-muted);
    font-size: 0.9375rem;
    font-weight: 400;
  }

  /* 年份节点：品牌色圆环，背景色盖住竖线形成「串珠」 */
  .tl-year-title::before {
    content: '';
    position: absolute;
    left: 0;
    top: 0.6em;
    width: 12px;
    height: 12px;
    border-radius: 50%;
    background-color: var(--background);
    border: 3px solid var(--cove-blue);
    transform: translateY(-50%);
  }

  .tl-list {
    margin: 0;
    padding: 0 0 0 2rem;
    list-style: none;
  }

  .tl-item {
    position: relative;
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.375rem 0.875rem;
    padding-block: 0.625rem;
    border-bottom: 1px solid var(--border);
    text-decoration-line: none;
  }

  /* 条目节点：默认与竖线同色，悬停点亮为品牌色（指南 8.6：仅颜色变化） */
  .tl-item::before {
    content: '';
    position: absolute;
    left: -29px;
    top: 50%;
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background-color: var(--border);
    transform: translateY(-50%);
    transition: background-color 150ms ease;
  }

  .tl-item time {
    color: var(--text-muted);
    font-family: var(--font-mono);
    font-size: 0.8125rem;
    white-space: nowrap;
    transition: color 150ms ease;
  }

  .tl-title {
    color: var(--text);
    line-height: 1.6;
    transition: color 120ms ease;
  }

  .tl-category {
    margin-left: auto;
    color: var(--text-muted);
    font-size: 0.8125rem;
  }

  .tl-item:hover::before {
    background-color: var(--cove-blue-strong);
  }

  .tl-item:hover time {
    color: var(--cove-blue);
  }

  .tl-item:hover .tl-title {
    color: var(--cove-blue-strong);
    text-decoration-line: underline;
    text-underline-offset: 0.3em;
  }

  .archive-empty {
    color: var(--text-muted);
  }
</style>
