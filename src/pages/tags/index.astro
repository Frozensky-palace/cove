---
/**
 * 标签总览页（评审报告 4.5 → IMPL-056）：此前仅有 /tags/[tag]/ 动态
 * 详情页，缺少总览入口，标签只能从文章页顺藤摸瓜。本页聚合全部标签
 * （文章 + 笔记），按出现次数降序列出，补齐「3 次点击内可达」的
 * 发现路径；页脚入口见 siteConfig.footerNav。
 */
import ContentLayout from '@/layouts/ContentLayout.astro';
import EmptyState from '@/components/content/EmptyState.astro';
import { collectTagStats } from '@/lib/content';

const tags = await collectTagStats();
/** 数量极值用于字号的视觉分层（克制：仅在两档之间过渡，不做词云） */
const max = Math.max(...tags.map((t) => t.count), 1);
const min = Math.min(...tags.map((t) => t.count), 1);
---

<ContentLayout
  title="标签"
  description={`全部标签，共 ${tags.length} 个。`}
  path="/tags/"
  heading="标签"
  intro="横跨文章与笔记的主题索引——数量越多，说明这个话题被反复写到。"
>
  {
    tags.length > 0 ? (
      <ul class="tag-cloud" role="list">
        {tags.map((tag) => {
          /* 两档字号：高频标签略大，其余统一，避免词云式的视觉噪音 */
          const emphasis = tag.count === max && max > min;
          return (
            <li>
              <a
                class="tag-chip"
                class:list={{ 'tag-chip--hot': emphasis }}
                href={`/tags/${tag.slug}/`}
              >
                <span class="tag-chip-name">{tag.label}</span>
                <span class="tag-chip-count">{tag.count}</span>
                <span class="sr-only"> 篇内容</span>
              </a>
            </li>
          );
        })}
      </ul>
    ) : (
      <EmptyState
        title="还没有标签"
        description="在文章或笔记的 frontmatter 里写 tags: ['标签名']，这里会自动长出来。"
      />
    )
  }
</ContentLayout>

<style>
  .tag-cloud {
    max-width: 46rem;
    margin: 0 auto;
    padding: 0;
    list-style: none;
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem 0.625rem;
  }

  .tag-chip {
    display: inline-flex;
    align-items: baseline;
    gap: 0.375rem;
    padding: 0.375rem 0.875rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    text-decoration-line: none;
    transition:
      border-color 150ms ease,
      background-color 150ms ease,
      color 150ms ease;
  }

  .tag-chip:hover {
    border-color: color-mix(in srgb, var(--cove-blue) 45%, transparent);
    background-color: color-mix(in srgb, var(--cove-blue) 6%, transparent);
  }

  .tag-chip-name {
    color: var(--text);
    font-size: 0.9375rem;
    line-height: 1.6;
  }

  /* 高频标签：略大的字号 + 品牌色点缀（指南 8.2：蓝粉只做一处关键视觉） */
  .tag-chip--hot .tag-chip-name {
    font-size: 1.0625rem;
  }

  .tag-chip:hover .tag-chip-name {
    color: var(--cove-blue-strong);
  }

  .tag-chip-count {
    color: var(--text-muted);
    font-size: 0.75rem;
    font-variant-numeric: tabular-nums;
  }

  .sr-only {
    position: absolute;
    width: 1px;
    height: 1px;
    padding: 0;
    margin: -1px;
    overflow: hidden;
    clip: rect(0 0 0 0);
    white-space: nowrap;
    border: 0;
  }
</style>
