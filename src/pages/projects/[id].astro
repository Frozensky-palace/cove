---
/**
 * 项目详情页（指南 9.6）：问题、角色、方法、过程与反思、链接、相关文章。
 * 正文结构由 Markdown 正文承担，结构化头部信息来自 frontmatter。
 * 封面（若有）在署名之后、正文之前展示，与文章详情同序（评审 D06：
 * 列表卡有封面而详情没有的不一致自此收敛）；
 * 链接/源码为页头操作按钮行（label 主文本 + 类型小字 + 类型图标），
 * 不再作为文末独立区块。
 */
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import ContentLayout from '@/layouts/ContentLayout.astro';
import AuthorByline from '@/components/content/AuthorByline.astro';
import ArticleListItem from '@/components/content/ArticleListItem.astro';
import GithubIcon from '@/components/base/icons/GithubIcon.astro';
import {
  formatDate,
  getPublishedProjects,
  resolveProjectRelatedPosts,
  isPreviewOnly,
  showPreviewContent,
  type Project,
} from '@/lib/content';
import { projectUrl } from '@/lib/urls';

export async function getStaticPaths() {
  const projects = await getPublishedProjects();
  return projects.map((project) => ({ params: { id: project.id }, props: { project } }));
}

interface Props {
  project: Project;
}

const { project } = Astro.props;
const { Content } = await render(project);
const related = await resolveProjectRelatedPosts(project);
const previewOnly = showPreviewContent && isPreviewOnly(project);

const statusLabel: Record<Project['data']['status'], string> = {
  active: '进行中',
  completed: '已完成',
  archived: '已归档',
};

const linkLabel: Record<string, string> = {
  demo: '在线演示',
  source: '源码',
  paper: '论文',
  download: '下载',
  other: '链接',
};
---

<ContentLayout
  title={project.data.title}
  description={project.data.summary}
  path={projectUrl(project.id)}
  noindex={previewOnly}
  imagePath={`/og/projects/${project.id}.png`}
  imageWidth={1200}
  imageHeight={630}
  imageAlt={project.data.title}
>
  {
    previewOnly && (
      <div class="preview-banner" role="note">
        预览内容：这个项目是{project.data.draft ? '草稿' : '计划发布内容'}，未进入生产输出。
      </div>
    )
  }
  <article
    class="project-article"
    data-pagefind-body
    data-pagefind-filter="类型:项目"
    data-pagefind-meta={`title:${project.data.title}`}
  >
    <div class="project-facts" data-pagefind-ignore>
      <span class:list={['project-status', `status-${project.data.status}`]}>
        {statusLabel[project.data.status]}
      </span>
      {
        project.data.startedAt && (
          <span class="fact">
            {project.data.completedAt
              ? `${project.data.startedAt.slice(0, 7)} — ${formatDate(project.data.completedAt)}`
              : `始于 ${formatDate(project.data.startedAt)}`}
          </span>
        )
      }
      {
        project.data.stack.length > 0 && (
          <span class="fact fact-stack">{project.data.stack.join(' · ')}</span>
        )
      }
    </div>

    {
      project.data.links.length > 0 && (
        <div class="project-actions" data-pagefind-ignore>
          {project.data.links.map((link) => {
            const typeText = linkLabel[link.type] ?? '链接';
            /* 评审 V03：label 与类型文案相同（如「源码/源码」）时只渲染一个可见
               标签，避免窄屏重复文案挤占横向空间；两者不同（如「复盘/在线演示」）
               保留类型小字补足语境。 */
            const showsType = link.label.trim() !== typeText;
            return (
              <a href={link.url} target="_blank" rel="noopener noreferrer">
                {link.type === 'source' ? (
                  <GithubIcon size={16} />
                ) : (
                  <svg
                    width="16"
                    height="16"
                    viewBox="0 0 24 24"
                    fill="none"
                    stroke="currentColor"
                    stroke-width="1.75"
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    aria-hidden="true"
                  >
                    <path d="M7 17 17 7" />
                    <path d="M8 7h9v9" />
                  </svg>
                )}
                <span class="action-label">{link.label}</span>
                {showsType && <span class="link-type">{typeText}</span>}
              </a>
            );
          })}
        </div>
      )
    }

    <AuthorByline authorKey={project.data.author} />

    {
      project.data.cover && (
        <div class="project-cover">
          <Image
            src={project.data.cover}
            alt={project.data.title}
            widths={[640, 960, 1280]}
            sizes="(min-width: 780px) 720px, 100vw"
          />
        </div>
      )
    }

    <div class="prose byline-gap">
      <Content />
    </div>

    {
      related.length > 0 && (
        <section class="project-related" aria-label="相关文章" data-pagefind-ignore>
          <h2 class="links-title">相关文章</h2>
          <div class="related-list">
            {related.map((post) => (
              <ArticleListItem post={post} />
            ))}
          </div>
        </section>
      )
    }
  </article>
</ContentLayout>

<style>
  .preview-banner {
    /* 与居中的正文列同宽（IMPL-053） */
    max-width: 46rem;
    margin-inline: auto;
    margin-bottom: 1.5rem;
    padding: 0.625rem 1.5rem;
    border-radius: var(--radius-control);
    background-color: var(--shell-pink-soft);
    color: var(--text);
    font-size: 0.875rem;
    text-align: center;
  }

  .project-article {
    max-width: 46rem;
    margin-inline: auto;
  }

  .project-facts {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.625rem 1.25rem;
    margin-bottom: 2rem;
  }

  /* 紧跟操作按钮行时收窄间距（:has 兜底为原 2rem，不影响无链接项目） */
  .project-facts:has(+ .project-actions) {
    margin-bottom: 1.25rem;
  }

  .project-status {
    padding-inline: 0.625rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .status-active {
    border-color: var(--cove-blue);
    color: var(--cove-blue-strong);
  }

  /* 评审 V02：文字用深粉语义令牌（白卡 5.62:1），描边保持装饰粉 */
  .status-completed {
    border-color: var(--shell-pink);
    color: var(--shell-pink-text);
  }

  .fact {
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .fact-stack {
    font-family: var(--font-mono);
    font-size: 0.8125rem;
  }

  /* 链接/源码操作行：页头可见的主操作（label 主文本 + 类型小字 + 类型图标） */
  .project-actions {
    display: flex;
    flex-wrap: wrap;
    gap: 0.625rem;
    margin-bottom: 2rem;
  }

  .project-actions a {
    display: inline-flex;
    align-items: center;
    gap: 0.4375rem;
    min-height: 44px;
    padding-inline: 1rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    background-color: var(--surface);
    color: var(--text);
    font-size: 0.875rem;
    font-weight: 600;
    text-decoration-line: none;
    transition:
      border-color var(--motion-fast) var(--ease-standard),
      color var(--motion-fast) var(--ease-standard);
  }

  .project-actions a svg {
    flex-shrink: 0;
    color: var(--cove-blue-strong);
  }

  .project-actions a:hover {
    border-color: color-mix(in srgb, var(--cove-blue-strong) 45%, transparent);
    color: var(--cove-blue-strong);
  }

  .link-type {
    color: var(--text-muted);
    font-size: 0.75rem;
    font-weight: 400;
  }

  /* 封面（若有）：署名之后、正文之前，与文章详情同序；视觉语言同 .article-cover */
  .project-cover {
    margin-top: 2rem;
    border-radius: var(--radius-overlay);
    overflow: hidden;
  }

  .project-cover :global(img) {
    width: 100%;
    height: auto;
  }

  /* 值守者署名与正文之间（署名块自身无边距）；有封面时间距由封面承担 */
  .byline-gap {
    margin-top: 2rem;
  }

  .links-title {
    margin: 2.5rem 0 1rem;
    font-size: 1.25rem;
    font-weight: 700;
  }

  .project-related {
    margin-top: 1rem;
    padding-top: 0.5rem;
  }
</style>
