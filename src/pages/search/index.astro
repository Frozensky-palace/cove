---
/**
 * 搜索页（指南 9.7）：可直接访问的完整搜索页；
 * 结果由 Pagefind 静态索引在浏览器端渲染，页面骨架为静态 HTML。
 */
import ContentLayout from '@/layouts/ContentLayout.astro';
import SearchPanel from '@/components/islands/SearchPanel.vue';
---

<ContentLayout
  title="搜索"
  description="搜索 Cove 的文章、笔记与项目。"
  path="/search/"
  heading="搜索"
  intro="输入关键词，查找全站的文章、笔记与项目。"
>
  <div class="search-column">
    <SearchPanel client:load />
  </div>
</ContentLayout>

<style>
  /* 搜索面板与居中的页头同列（IMPL-053） */
  .search-column {
    max-width: 46rem;
    margin-inline: auto;
  }
</style>
