---
/**
 * 关于页（指南 9.8）：介绍作者、Cove 的含义、长期主题、联系方式和 RSS。
 * 内容应真实具体，避免能力图标墙和百分比进度条。
 * 站点信息一律取自 siteConfig（IMPL-005：占位值待 Phase 0 确认项替换）。
 * Phase 8.1（IMPL-051）：长期主题链接分类、「最近在写」最新 3 篇内链、
 * 联系方式显示真实邮箱、heading 名字品牌渐变标记、链接 hover 抛光、
 * ProfilePage JSON-LD（经 ContentLayout 新增的 jsonLd 透传）。
 */
import ContentLayout from '@/layouts/ContentLayout.astro';
import { siteConfig } from '@/data/site';
import { categoryUrl, postUrl } from '@/lib/urls';
import { formatDate, getPublishedPosts } from '@/lib/content';
import { profilePageJsonLd } from '@/lib/seo';
import RssIcon from '@/components/base/icons/RssIcon.astro';

const recentPosts = (await getPublishedPosts()).slice(0, 3);
---

<ContentLayout
  title="关于"
  intro="这里是我的小海湾：写长文、记短想、做项目，也留下过程与反思。"
  description={`关于 ${siteConfig.name} 与 ${siteConfig.author.name}：写作、笔记与项目的长期主题，以及联系方式与订阅方式。`}
  path="/about/"
  jsonLd={[profilePageJsonLd()]}
>
  {/* heading 走具名 slot 覆盖默认标题：名字部分做品牌渐变标记（IMPL-051） */}
  <span slot="heading">你好，我是 <span class="about-name">{siteConfig.author.name}</span></span>

  <div class="about prose">
    <h2>Cove 是什么</h2>
    <p>
      Cove 的本意是「小海湾」。我希望这个站点像一片安静的小海湾：潮水来去，
      沉淀下来的都是值得留住的文字与作品。这里没有热点的喧嚣，只有三样东西——
      完整论述的<strong>文章</strong>、随手记录的<strong>笔记</strong>，
      以及有过程、有反思的<strong>项目</strong>。
    </p>

    <h2>长期主题</h2>
    <p>我关注的方向会随时间慢慢生长，目前主要包括：</p>
    <ul>
      <li>
        <a href={categoryUrl('engineering')}>前端工程与类型系统</a>：把复杂问题拆成可维护的结构；
      </li>
      <li>
        <a href={categoryUrl('web-dev')}>静态站点与内容工程</a>：以 Git 为源、构建即发布的工作流；
      </li>
      <li>
        <a href={categoryUrl('reading')}>技术写作与知识整理</a>：让笔记真正被自己再次读到。
      </li>
    </ul>

    {recentPosts.length > 0 && (
      <>
        <h2>最近在写</h2>
        <ul class="about-recent">
          {recentPosts.map((post) => (
            <li>
              <a href={postUrl(post.id)}>{post.data.title}</a>
              <span class="about-recent-date">{formatDate(post.data.publishedAt)}</span>
            </li>
          ))}
        </ul>
      </>
    )}

    <h2>这个站点如何运转</h2>
    <p>
      Cove 由 <a href="https://astro.build/">Astro</a> 静态构建，内容以 Markdown
      存放在 Git 仓库中，部署在 Cloudflare 上。没有追踪脚本，没有行为广告；
      搜索在浏览器本地完成。你可以在
      <a href="/archive/">归档</a> 里按年份回看全部内容。
    </p>

    <h2>联系与订阅</h2>
    <p>欢迎通过以下方式找到我，或订阅 RSS 及时获取新文章。</p>
    <ul class="about-links">
      <li>
        <a href="/rss.xml">
          <RssIcon />
          RSS 订阅
        </a>
      </li>
      {
        siteConfig.social.map((link) => (
          <li>
            <a href={link.href} rel="me noopener">
              {link.href.startsWith('mailto:') ? link.href.replace(/^mailto:/, '') : link.label}
            </a>
          </li>
        ))
      }
    </ul>
  </div>
</ContentLayout>

<style>
  .about {
    max-width: 720px;
  }

  /* 名字品牌渐变标记（IMPL-051）：Logo 同款双色（--cove-blue → --shell-pink）
     作 0.16em 底部标记线；文字保持正文色，对比度不降（Lighthouse 待验收） */
  .about-name {
    background-image: linear-gradient(90deg, var(--cove-blue), var(--shell-pink));
    background-repeat: no-repeat;
    background-size: 100% 0.16em;
    background-position: 0 100%;
    padding-bottom: 0.05em;
  }

  /* 「最近在写」条目：题左日期右；hover 语言与下方 about-links 一致；
     键盘焦点环由 global.css 全局 :focus-visible 提供，不在此重复 */
  .about-recent {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 0.5rem;
  }

  .about-recent li {
    display: flex;
    align-items: baseline;
    justify-content: space-between;
    gap: 1rem;
    margin: 0;
  }

  .about-recent a {
    color: var(--text);
  }

  .about-recent-date {
    flex-shrink: 0;
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .about-links {
    list-style: none;
    padding: 0;
    display: flex;
    flex-wrap: wrap;
    gap: 0.75rem 1.5rem;
  }

  .about-links a {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    color: var(--cove-blue-strong);
  }

  .about-links a :global(svg) {
    width: 1em;
    height: 1em;
  }

  /* 链接 hover 抛光（IMPL-051）：下划线提示可点，160ms 颜色过渡
     与全站控件一致；不变更到低对比颜色 */
  .about-links a,
  .about-recent a {
    transition: color 160ms ease;
  }

  .about-links a:hover,
  .about-recent a:hover {
    text-decoration: underline;
    text-underline-offset: 0.2em;
  }

  .about-recent a:hover {
    color: var(--cove-blue-strong);
  }
</style>
