---
/**
 * 分类聚合页（指南 7.2）：单一主分类下的文章；
 * 侧向提供全部分类切换与归档入口（普通链接，无 JS 可用）。
 */
import ContentLayout from '@/layouts/ContentLayout.astro';
import ArticleListItem from '@/components/content/ArticleListItem.astro';
import EmptyState from '@/components/content/EmptyState.astro';
import Button from '@/components/base/Button.astro';
import { categoryLabel, type CategoryKey } from '@/data/taxonomy';
import { categoryUrl } from '@/lib/urls';
import { getCategoryStats, getPostsByCategory } from '@/lib/content';

export async function getStaticPaths() {
  const stats = await getCategoryStats();
  return stats.map(({ key }) => ({ params: { category: key } }));
}

const { category } = Astro.params;
const key = category as CategoryKey;
const posts = await getPostsByCategory(key);
const stats = await getCategoryStats();
const label = categoryLabel(key);
---

<ContentLayout
  title={`${label} · 分类`}
  description={`分类「${label}」下的全部文章，共 ${posts.length} 篇。`}
  path={categoryUrl(key)}
  heading={label}
  intro={`这个分类下共有 ${posts.length} 篇文章。`}
>
  <nav class="category-switch" aria-label="切换分类">
    <ul>
      {
        stats.map(({ key: k, count }) => (
          <li>
            <a
              href={categoryUrl(k)}
              class:list={['cat-link', { 'cat-current': k === key }]}
              aria-current={k === key ? 'page' : undefined}
            >
              {categoryLabel(k)}
              <span class="cat-count">（{count}）</span>
            </a>
          </li>
        ))
      }
    </ul>
    <a class="archive-entry" href="/archive/">按年份归档 →</a>
  </nav>

  {
    posts.length > 0 ? (
      <div class="category-list">
        {posts.map((post) => (
          <ArticleListItem post={post} />
        ))}
      </div>
    ) : (
      <EmptyState title="这个分类还没有文章" description="内容正在路上，可以先看看其他分类或回到文章列表。">
        <Button href="/posts/" variant="secondary" slot="actions">
          全部文章
        </Button>
      </EmptyState>
    )
  }
</ContentLayout>

<style>
  .category-switch {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.75rem 1.5rem;
    margin-bottom: 2rem;
    padding-bottom: 1rem;
    border-bottom: 1px solid var(--border);
  }

  .category-switch ul {
    display: flex;
    flex-wrap: wrap;
    gap: 0.25rem 0.75rem;
    margin: 0;
    padding: 0;
    list-style: none;
  }

  .cat-link {
    color: var(--text-muted);
    font-size: 0.875rem;
    text-decoration-line: none;
    transition: color 150ms ease;
  }

  .cat-link:hover {
    color: var(--cove-blue-strong);
    text-decoration-line: underline;
    text-underline-offset: 0.3em;
  }

  .cat-current {
    color: var(--text);
    font-weight: 600;
    text-decoration-line: underline;
    text-decoration-color: var(--cove-blue-strong);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.4em;
  }

  .cat-count {
    color: var(--text-muted);
    font-size: 0.8125rem;
  }

  .archive-entry {
    color: var(--text-muted);
    font-size: 0.875rem;
    white-space: nowrap;
    text-decoration-line: none;
  }

  .archive-entry:hover {
    color: var(--cove-blue-strong);
    text-decoration-line: underline;
    text-underline-offset: 0.3em;
  }

  .category-list {
    max-width: 46rem;
  }
</style>
