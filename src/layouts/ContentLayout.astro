---
/**
 * 通用内容页布局：页头（标题 + 描述）+ 容器 slot。
 * 用于列表页、笔记、项目、关于页等非文章页面。
 */
import BaseLayout from '@/layouts/BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  /** 页头大标题（H1） */
  heading?: string;
  /** 页头说明文字 */
  intro?: string;
  noindex?: boolean;
  /** 社交分享图（IMPL-056）：站内构建产物路径（如 /og/projects/<id>.png），
      缺省回落 BaseLayout 的默认分享图 */
  imagePath?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
  /** 页面级结构化数据（透传 BaseLayout，Person 全站输出不在此传；IMPL-051） */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  path,
  heading,
  intro,
  noindex = false,
  imagePath,
  imageWidth,
  imageHeight,
  imageAlt,
  jsonLd = [],
} = Astro.props;
---

<BaseLayout
  title={title}
  description={description}
  path={path}
  noindex={noindex}
  imagePath={imagePath}
  imageWidth={imageWidth}
  imageHeight={imageHeight}
  imageAlt={imageAlt}
  jsonLd={jsonLd}
>
  <div class="cove-container content-page">
    <header class="page-header">
      <h1 class="page-title"><slot name="heading">{heading ?? title}</slot></h1>
      {intro && <p class="page-intro">{intro}</p>}
      <slot name="header-actions" />
    </header>
    <slot />
  </div>
</BaseLayout>

<style>
  .content-page {
    padding-block: 2.5rem 4rem;
  }

  .page-header {
    max-width: 46rem;
    /* 内容列在 1200px 容器内水平居中（IMPL-053）：仅设 max-width 会贴左缘 */
    margin-inline: auto;
    margin-bottom: 2.5rem;
  }

  .page-title {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0.01em;
  }

  .page-intro {
    margin: 1rem 0 0;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.85;
  }
</style>
