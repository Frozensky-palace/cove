---
/**
 * 通用内容页布局：页头（标题 + 描述）+ 容器 slot。
 * 用于列表页、笔记、项目、关于页等非文章页面。
 */
import BaseLayout from '@/layouts/BaseLayout.astro';

interface Props {
  title: string;
  description: string;
  path: string;
  /** 页头大标题（H1） */
  heading?: string;
  /** 页头说明文字 */
  intro?: string;
  noindex?: boolean;
}

const { title, description, path, heading, intro, noindex = false } = Astro.props;
---

<BaseLayout title={title} description={description} path={path} noindex={noindex}>
  <div class="cove-container content-page">
    <header class="page-header">
      <h1 class="page-title">{heading ?? title}</h1>
      {intro && <p class="page-intro">{intro}</p>}
      <slot name="header-actions" />
    </header>
    <slot />
  </div>
</BaseLayout>

<style>
  .content-page {
    padding-block: 2.5rem 4rem;
  }

  .page-header {
    max-width: 46rem;
    margin-bottom: 2.5rem;
  }

  .page-title {
    margin: 0;
    font-size: clamp(1.75rem, 4vw, 2.25rem);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0.01em;
  }

  .page-intro {
    margin: 1rem 0 0;
    color: var(--text-muted);
    font-size: 1rem;
    line-height: 1.85;
  }
</style>
