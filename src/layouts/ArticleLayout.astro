---
/**
 * 文章详情布局（指南 9.4）：
 * 分类面包屑 → 标题/描述 → 元信息 → 值守者署名 → 可选封面 → 正文 +
 * 桌面右侧粘性目录（IMPL-020）→ 标签/转载说明 → 上一篇/下一篇 → 相关文章。
 * 署名统一置于正文上方（与笔记/项目详情一致，IMPL-053 三轮）；
 * ≥1280px 三栏真居中：阅读列为容器正中，目录占右侧 1fr 列。
 * 阅读进度为顶部 2px 细线；代码复制为原生脚本渐进增强；
 * 正文容器标注 data-pagefind-body（Phase 4 搜索索引）。
 */
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import BaseLayout from '@/layouts/BaseLayout.astro';
import ArticleTOC from '@/components/content/ArticleTOC.astro';
import PostMeta from '@/components/content/PostMeta.astro';
import AuthorByline from '@/components/content/AuthorByline.astro';
import TagList from '@/components/content/TagList.astro';
import PrevNextNav from '@/components/content/PrevNextNav.astro';
import RelatedPosts from '@/components/content/RelatedPosts.astro';
import SeriesCard from '@/components/content/SeriesCard.astro';
import CommentProvider from '@/components/integrations/CommentProvider.astro';
import {
  getAdjacentPosts,
  getRelatedPosts,
  getSeriesGroup,
  isPreviewOnly,
  shanghaiDate,
  showPreviewContent,
  type Post,
} from '@/lib/content';
import { categoryLabel } from '@/data/taxonomy';
import { categoryUrl, postUrl } from '@/lib/urls';
import { articleBreadcrumb, blogPostingJsonLd, DEFAULT_OG_IMAGE, resolveSiteURL } from '@/lib/seo';

interface Props {
  post: Post;
}

const { post } = Astro.props;
const { Content, headings } = await render(post);
const { prev, next } = await getAdjacentPosts(post);
const related = await getRelatedPosts(post);
const previewOnly = showPreviewContent && isPreviewOnly(post);

/* 所属系列（指南 11.1 预留字段）：有 series 且当前文章在组内时，正文上方渲染系列卡 */
const seriesGroup = post.data.series ? await getSeriesGroup(post.data.series) : null;
const showSeriesCard =
  seriesGroup !== null && seriesGroup.posts.some((entry) => entry.id === post.id);

/* 社交分享图：封面为位图时用封面（SVG 封面多数平台不识别，回退默认图） */
const cover = post.data.cover;
const ogImageProps =
  cover && cover.format !== 'svg'
    ? { imagePath: cover.src, imageWidth: cover.width, imageHeight: cover.height }
    : {};
const ogImageURL = resolveSiteURL(ogImageProps.imagePath ?? DEFAULT_OG_IMAGE.path);
const ogMetadata = {
  ...ogImageProps,
  ogType: 'article' as const,
  publishedTime: shanghaiDate(post.data.publishedAt).toISOString(),
};
---

<BaseLayout
  title={post.data.title}
  description={post.data.description}
  path={postUrl(post.id)}
  noindex={previewOnly}
  {...ogMetadata}
  jsonLd={[blogPostingJsonLd(post, ogImageURL), articleBreadcrumb(post)]}
>
  {previewOnly && (
    <div class="preview-banner" role="note">
      预览内容：这篇文章是{post.data.draft ? '草稿' : '计划发布内容'}，未进入生产输出。
    </div>
  )}

  <div class="cove-container article-page">
    <article class="article" data-pagefind-body data-pagefind-filter="类型:文章">
      {/* 三栏骨架（指南 8.7 / 9.4，IMPL-053 三轮）：页头、正文与上下篇固定在
          中列（45rem，与 .prose 行宽 720px 对齐，≥1280px 时恰为容器正中）；
          ArticleTOC 片段展开为两个兄弟元素——.toc-mobile（<1280px 正文前折叠
          目录）与 .toc-aside（≥1280px 右侧 1fr 列，自身粘性）。 */}
      <div class="article-columns">
        <header class="article-header">
          <nav class="article-breadcrumb" aria-label="面包屑">
            <a href="/posts/">文章</a>
            <span aria-hidden="true">/</span>
            <a href={categoryUrl(post.data.category)}>
              {categoryLabel(post.data.category)}
            </a>
          </nav>

          <h1 class="article-title" data-pagefind-meta="title">{post.data.title}</h1>
          <p class="article-description">{post.data.description}</p>
          <PostMeta post={post} pagefind showAuthor={false} />
          <AuthorByline authorKey={post.data.author} />

          {
            post.data.cover && (
              <div class="article-cover">
                <Image
                  src={post.data.cover}
                  alt={post.data.coverAlt ?? ''}
                  widths={[640, 960, 1280]}
                  sizes="(min-width: 780px) 720px, 100vw"
                  loading="eager"
                  fetchpriority="high"
                />
              </div>
            )
          }
        </header>

        {/* 目录（IMPL-020 / IMPL-053 三轮）：署名已回页头（与笔记/项目详情统一），
            此处只剩目录；<1280px 为正文前折叠目录，≥1280px 落入网格右列。 */}
        <ArticleTOC headings={headings} />

        <div class="article-main">
          {showSeriesCard && seriesGroup && (
            <SeriesCard series={seriesGroup} currentId={post.id} />
          )}

          <div class="prose">
            <Content />
          </div>

          <footer class="article-footer" data-pagefind-ignore>
            <TagList tags={post.data.tags} />
            {
              post.data.canonicalURL && (
                <p class="canonical-note">
                  本文首发于
                  <a href={post.data.canonicalURL} rel="canonical">
                    {post.data.canonicalURL}
                  </a>
                  ，转载已获授权。
                </p>
              )
            }
          </footer>
        </div>

        <div class="article-nav-area" data-pagefind-ignore>
          <PrevNextNav prev={prev} next={next} />
          <RelatedPosts posts={related} />
        </div>
      </div>

      {/* 评论区（指南 9.4 / 19 Phase 6）：草稿与计划发布的预览页不渲染，避免污染讨论映射 */}
      {!previewOnly && <CommentProvider />}
    </article>
  </div>
</BaseLayout>

<style>
  .preview-banner {
    /* 与居中的内容列同宽（IMPL-053） */
    max-width: 45rem;
    margin-inline: auto;
    margin-bottom: 1.5rem;
    padding: 0.625rem 1.5rem;
    border-radius: var(--radius-control);
    background-color: var(--shell-pink-soft);
    color: var(--text);
    font-size: 0.875rem;
    text-align: center;
  }

  .article-page {
    padding-block: 2rem 4rem;
  }

  .article-header {
    max-width: 45rem;
    margin-inline: auto;
    margin-bottom: 2rem;
    display: flex;
    flex-direction: column;
    gap: 1rem;
  }

  .article-breadcrumb {
    display: flex;
    gap: 0.5rem;
    font-size: 0.8125rem;
    color: var(--text-muted);
  }

  .article-breadcrumb a {
    color: var(--text-muted);
    text-decoration-line: none;
  }

  .article-breadcrumb a:hover {
    color: var(--cove-blue-strong);
    text-decoration-line: underline;
    text-underline-offset: 0.3em;
  }

  .article-title {
    margin: 0;
    font-size: clamp(1.75rem, 5vw, 2.5rem);
    font-weight: 700;
    line-height: 1.35;
    letter-spacing: 0.01em;
  }

  .article-description {
    margin: 0;
    color: var(--text-muted);
    font-size: 1.0625rem;
    line-height: 1.8;
  }

  .article-cover {
    margin-top: 0.5rem;
    border-radius: var(--radius-overlay);
    overflow: hidden;
  }

  .article-cover :global(img) {
    width: 100%;
    height: auto;
  }

  /* 三栏真居中（≥1280px，IMPL-053 三轮）：1fr | 45rem | 1fr——阅读列恰为容器
     正中，消除旧「内容+右栏」整块居中带来的整体偏左感；目录占右侧 1fr 列
     （自身 sticky / 限高由组件维护），跨页头/正文/上下篇三行放置。
     <1280px 为纵向文档流：页头（含署名卡）→ 折叠目录 → 正文 → 上下篇。 */
  .article-columns {
    display: flex;
    flex-direction: column;
  }

  @media (min-width: 1280px) {
    .article-columns {
      display: grid;
      grid-template-columns: minmax(0, 1fr) minmax(0, 45rem) minmax(0, 1fr);
      grid-template-rows: auto auto auto;
      row-gap: 2.5rem;
      align-items: start;
    }

    .article-header {
      grid-column: 2;
      grid-row: 1;
      margin-bottom: 0;
    }

    .article-main {
      grid-column: 2;
      grid-row: 2;
    }

    .article-nav-area {
      grid-column: 2;
      grid-row: 3;
      margin-top: 0;
    }

    /* 目录落入右列（容器 1200px 减 45rem 中列后两侧各约 13.5rem，
       margin-left 与中列留出呼吸）；组件自身 sticky（top 96px 避让吸顶页头）
       在跨三行的网格区域内全程跟随 */
    .article-columns :global(.toc-aside) {
      grid-column: 3;
      grid-row: 1 / span 3;
      margin-left: 2.5rem;
    }
  }

  .article-main {
    min-width: 0;
  }

  /* 系列卡与正文的间距由布局控制（组件内部不感知所处上下文） */
  .article-main :global(.series-card) {
    margin-bottom: 2rem;
  }

  .article-footer {
    max-width: 720px;
    margin-top: 2.5rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    display: flex;
    flex-direction: column;
    gap: 0.875rem;
  }

  .canonical-note {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.8125rem;
    line-height: 1.7;
  }

  .canonical-note a {
    color: var(--cove-blue-strong);
    text-underline-offset: 0.25em;
    /* 转载说明直接渲染完整 URL：窄屏允许任意断点 */
    overflow-wrap: anywhere;
  }

  .article-nav-area {
    max-width: 45rem;
    margin-inline: auto;
    margin-top: 2rem;
  }
</style>

<script>
  /**
   * ClientRouter 环境（IMPL-017）：初始化挂在 astro:page-load 上，
   * 首次加载与每次换页后触发；先移除旧进度条保证幂等。
   */
  let progressCleanup: AbortController | null = null;

  function initArticleEnhancements(): void {
    /* 中止上一页遗留的 scroll/resize 监听（window 跨换页存活） */
    progressCleanup?.abort();
    progressCleanup = null;
    document.querySelector('.reading-progress')?.remove();
    const articleQuery = document.querySelector<HTMLElement>('article[data-pagefind-body]');
    if (!articleQuery) return;
    /* 守卫后别名：astro check 对闭包内的收窄不可靠，别名固定非空类型 */
    const article: HTMLElement = articleQuery;

    /** 阅读进度：顶部 2px 细线（指南 9.4），scroll 驱动，reduced-motion 下同样即时。 */
    const bar = document.createElement('div');
    bar.className = 'reading-progress';
    bar.setAttribute('aria-hidden', 'true');
    document.body.prepend(bar);

    function updateProgress() {
      const rect = article.getBoundingClientRect();
      const total = rect.height - window.innerHeight;
      if (total <= 0) {
        bar.style.transform = 'scaleX(1)';
        return;
      }
      const progress = Math.min(1, Math.max(0, -rect.top / total));
      bar.style.transform = `scaleX(${progress})`;
    }

    progressCleanup = new AbortController();
    window.addEventListener('scroll', updateProgress, {
      passive: true,
      signal: progressCleanup.signal,
    });
    window.addEventListener('resize', updateProgress, { signal: progressCleanup.signal });
    updateProgress();

    /**
     * 代码复制按钮（指南 9.4 / 10 CodeCopyButton）：原生脚本渐进增强，
     * 无 JS 时代码块仍完整可读，用户可手动选择复制。
     */
    for (const pre of document.querySelectorAll<HTMLPreElement>('pre.astro-code')) {
      const button = document.createElement('button');
      button.type = 'button';
      button.className = 'code-copy';
      button.textContent = '复制';
      button.addEventListener('click', async () => {
        const code = pre.querySelector('code')?.innerText ?? '';
        try {
          await navigator.clipboard.writeText(code);
          button.textContent = '已复制';
        } catch {
          button.textContent = '复制失败';
        }
        setTimeout(() => {
          button.textContent = '复制';
        }, 1600);
      });
      pre.append(button);
    }
  }

  document.addEventListener('astro:page-load', initArticleEnhancements);
</script>

<style is:global>
  .reading-progress {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 60;
    width: 100%;
    height: 2px;
    background-color: var(--cove-blue-strong);
    transform-origin: 0 50%;
    transform: scaleX(0);
    pointer-events: none;
  }
</style>
