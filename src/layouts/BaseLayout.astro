---
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '@/components/navigation/SiteHeader.astro';
import SiteFooter from '@/components/navigation/SiteFooter.astro';
import AppSplash from '@/components/base/AppSplash.astro';
import RouteProgress from '@/components/base/RouteProgress.astro';
import { buildMetadata, personJsonLd } from '@/lib/seo';
import { siteConfig } from '@/data/site';

interface Props {
  /** 页面标题（不含站名后缀） */
  title: string;
  /** 页面描述，缺省回退站点描述 */
  description?: string;
  /** 站内路径，用于 canonical 与 og:url */
  path?: string;
  /** 预览/开发页面设为 true（指南 13.1） */
  noindex?: boolean;
  /** 页面语言，默认 zh-CN */
  lang?: string;
  /** 站内图片路径，覆盖默认分享图 */
  imagePath?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
  /** og:type，文章页为 article */
  ogType?: 'website' | 'article';
  /** og:type=article 时的发布时间（ISO 8601） */
  publishedTime?: string;
  /** 页面级结构化数据（指南 13.2；Person 全站输出，不在此传） */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  path = '/',
  noindex = false,
  lang = 'zh-CN',
  imagePath,
  imageWidth,
  imageHeight,
  imageAlt,
  ogType,
  publishedTime,
  jsonLd = [],
} = Astro.props;
const meta = buildMetadata({
  title,
  description,
  path,
  noindex,
  imagePath,
  imageWidth,
  imageHeight,
  imageAlt,
  ogType,
  publishedTime,
});
const structuredData = [personJsonLd(), ...jsonLd];
---

<!doctype html>
<!-- no-js：JS 可用时由下方引导脚本移除；用于窄屏导航的渐进增强回退 -->
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={meta.canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    {meta.noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* 站内导航：View Transitions 路由（IMPL-017）——旧页保留至新页就绪，
        消除整页白屏间隔；加载反馈由 AppSplash / RouteProgress 承担 */}
    <ClientRouter />

    <meta property="og:type" content={meta.ogType} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={meta.canonical} />
    <meta property="og:image" content={meta.image.url} />
    <meta property="og:image:width" content={String(meta.image.width)} />
    <meta property="og:image:height" content={String(meta.image.height)} />
    <meta property="og:image:alt" content={meta.image.alt} />
    {
      meta.ogType === 'article' && meta.publishedTime && (
        <meta property="article:published_time" content={meta.publishedTime} />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={meta.image.url} />

    {
      structuredData.map((data) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
      ))
    }

    <!-- 主题引导：在首次绘制前恢复主题，避免闪烁（指南 4.2 / 10，IMPL-011）。
         必须保持 is:inline 且自包含，不依赖任何外部资源。
         两态（浅色/深色）：无存值时以系统偏好作一次性初始值，不作为可切换模式暴露。 -->
    <script is:inline>
      (function () {
        var mode = 'light';
        try {
          var stored = localStorage.getItem('cove:theme');
          mode =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
        } catch (e) {
          /* 隐私模式等场景下回退到系统偏好 */
          mode = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        var root = document.documentElement;
        root.classList.remove('no-js');
        root.classList.toggle('dark', mode === 'dark');
        root.dataset.theme = mode;
        root.style.colorScheme = mode;
        /* 首绘前同步注入图标状态规则（与 global.css 中未分层规则保持一致），
           覆盖 dev 模式下 CSS 异步注入前的空窗，避免同时闪现两个图标。
           带 id 复用：ClientRouter 换页会重执行本内联脚本（IMPL-017），
           不加防护会导致镜像 style 标签逐次累积。 */
        var MIRROR_ID = 'cove-theme-icon-rules';
        var style = document.getElementById(MIRROR_ID);
        if (!style) {
          style = document.createElement('style');
          style.id = MIRROR_ID;
          document.head.appendChild(style);
        }
        style.textContent =
          'html:not([data-theme=dark]) .theme-icon-light{display:flex}' +
          'html:not([data-theme=dark]) .theme-icon-dark{display:none}' +
          'html[data-theme=dark] .theme-icon-light{display:none}' +
          'html[data-theme=dark] .theme-icon-dark{display:flex}';
      })();
    </script>
  </head>
  <body>
    <AppSplash />
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <SiteHeader />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <RouteProgress />
  </body>
</html>
