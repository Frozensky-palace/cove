---
import '@/styles/global.css';
import SiteHeader from '@/components/navigation/SiteHeader.astro';
import SiteFooter from '@/components/navigation/SiteFooter.astro';
import { buildMetadata } from '@/lib/seo';

interface Props {
  /** 页面标题（不含站名后缀） */
  title: string;
  /** 页面描述，缺省回退站点描述 */
  description?: string;
  /** 站内路径，用于 canonical 与 og:url */
  path?: string;
  /** 预览/开发页面设为 true（指南 13.1） */
  noindex?: boolean;
  /** 页面语言，默认 zh-CN */
  lang?: string;
}

const { title, description, path = '/', noindex = false, lang = 'zh-CN' } = Astro.props;
const meta = buildMetadata({ title, description, path, noindex });
---

<!doctype html>
<!-- no-js：JS 可用时由下方引导脚本移除；用于窄屏导航的渐进增强回退 -->
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={meta.canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <meta name="generator" content={Astro.generator} />
    {meta.noindex && <meta name="robots" content="noindex, nofollow" />}

    <meta property="og:type" content={meta.ogType} />
    <meta property="og:site_name" content="Cove" />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={meta.canonical} />
    <meta name="twitter:card" content="summary" />

    <!-- 主题引导：在首次绘制前恢复主题，避免闪烁（指南 4.2 / 10，IMPL-011）。
         必须保持 is:inline 且自包含，不依赖任何外部资源。
         两态（浅色/深色）：无存值时以系统偏好作一次性初始值，不作为可切换模式暴露。 -->
    <script is:inline>
      (function () {
        var mode = 'light';
        try {
          var stored = localStorage.getItem('cove:theme');
          mode =
            stored === 'light' || stored === 'dark'
              ? stored
              : window.matchMedia('(prefers-color-scheme: dark)').matches
                ? 'dark'
                : 'light';
        } catch (e) {
          /* 隐私模式等场景下回退到系统偏好 */
          mode = window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }
        var root = document.documentElement;
        root.classList.remove('no-js');
        root.classList.toggle('dark', mode === 'dark');
        root.dataset.theme = mode;
        root.style.colorScheme = mode;
        /* 首绘前同步注入图标状态规则（与 global.css 中未分层规则保持一致），
           覆盖 dev 模式下 CSS 异步注入前的空窗，避免同时闪现两个图标。 */
        var style = document.createElement('style');
        style.textContent =
          'html:not([data-theme=dark]) .theme-icon-light{display:flex}' +
          'html:not([data-theme=dark]) .theme-icon-dark{display:none}' +
          'html[data-theme=dark] .theme-icon-light{display:none}' +
          'html[data-theme=dark] .theme-icon-dark{display:flex}';
        document.head.appendChild(style);
      })();
    </script>
  </head>
  <body>
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <SiteHeader />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
  </body>
</html>
