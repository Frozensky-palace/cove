---
import '@/styles/global.css';
import { ClientRouter } from 'astro:transitions';
import SiteHeader from '@/components/navigation/SiteHeader.astro';
import SiteFooter from '@/components/navigation/SiteFooter.astro';
import AppSplash from '@/components/base/AppSplash.astro';
import RouteProgress from '@/components/base/RouteProgress.astro';
import { buildMetadata, personJsonLd } from '@/lib/seo';
import { siteConfig } from '@/data/site';

interface Props {
  /** 页面标题（不含站名后缀） */
  title: string;
  /** 页面描述，缺省回退站点描述 */
  description?: string;
  /** 站内路径，用于 canonical 与 og:url */
  path?: string;
  /** 预览/开发页面设为 true（指南 13.1） */
  noindex?: boolean;
  /** 页面语言，默认 zh-CN */
  lang?: string;
  /** 站内图片路径，覆盖默认分享图 */
  imagePath?: string;
  imageWidth?: number;
  imageHeight?: number;
  imageAlt?: string;
  /** og:type，文章页为 article */
  ogType?: 'website' | 'article';
  /** og:type=article 时的发布时间（ISO 8601） */
  publishedTime?: string;
  /** 页面级结构化数据（指南 13.2；Person 全站输出，不在此传） */
  jsonLd?: Record<string, unknown>[];
}

const {
  title,
  description,
  path = '/',
  noindex = false,
  lang = 'zh-CN',
  imagePath,
  imageWidth,
  imageHeight,
  imageAlt,
  ogType,
  publishedTime,
  jsonLd = [],
} = Astro.props;
const meta = buildMetadata({
  title,
  description,
  path,
  noindex,
  imagePath,
  imageWidth,
  imageHeight,
  imageAlt,
  ogType,
  publishedTime,
});
const structuredData = [personJsonLd(), ...jsonLd];
---

<!doctype html>
<!-- no-js：JS 可用时由下方引导脚本移除；用于窄屏导航的渐进增强回退 -->
<html lang={lang} class="no-js">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />

    <title>{meta.title}</title>
    <meta name="description" content={meta.description} />
    <link rel="canonical" href={meta.canonical} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/site.webmanifest" />
    <meta name="generator" content={Astro.generator} />
    {meta.noindex && <meta name="robots" content="noindex, nofollow" />}

    {/* 站内导航：View Transitions 路由（IMPL-017）——旧页保留至新页就绪，
        消除整页白屏间隔；加载反馈由 AppSplash / RouteProgress 承担 */}
    <ClientRouter />

    <meta property="og:type" content={meta.ogType} />
    <meta property="og:site_name" content={siteConfig.name} />
    <meta property="og:locale" content="zh_CN" />
    <meta property="og:title" content={meta.title} />
    <meta property="og:description" content={meta.description} />
    <meta property="og:url" content={meta.canonical} />
    <meta property="og:image" content={meta.image.url} />
    <meta property="og:image:width" content={String(meta.image.width)} />
    <meta property="og:image:height" content={String(meta.image.height)} />
    <meta property="og:image:alt" content={meta.image.alt} />
    {
      meta.ogType === 'article' && meta.publishedTime && (
        <meta property="article:published_time" content={meta.publishedTime} />
      )
    }
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={meta.title} />
    <meta name="twitter:description" content={meta.description} />
    <meta name="twitter:image" content={meta.image.url} />

    {
      structuredData.map((data) => (
        <script is:inline type="application/ld+json" set:html={JSON.stringify(data)} />
      ))
    }

    <!-- 主题引导与首绘前关键规则（指南 4.2 / 10，IMPL-011/018/019）。
         必须保持 is:inline 且自包含，不依赖任何外部资源。
         两态（浅色/深色）：无存值时以系统偏好作一次性初始值，不作为可切换模式暴露。
         ClientRouter（IMPL-017）换页会把 <html> 属性覆盖回服务端渲染态
         （class="no-js"、无 dark/data-theme）——导致深色被重置为浅色。
         故在 astro:after-swap（换页完成、绘制前同步触发）重放全部状态。
         搜索回退链接不在此处处理：已改由 noscript 提供（IMPL-019），
         不参与任何样式竞争。 -->
    <script is:inline>
      (function () {
        function resolveMode() {
          try {
            var stored = localStorage.getItem('cove:theme');
            if (stored === 'light' || stored === 'dark') return stored;
          } catch (e) {
            /* 隐私模式等场景：回退到系统偏好 */
          }
          return window.matchMedia('(prefers-color-scheme: dark)').matches ? 'dark' : 'light';
        }

        /* 镜像规则：覆盖 dev 模式下 Vite 异步注入 CSS 前的空窗。
           与 global.css / SiteHeader / AppSplash 中的正式规则保持一致，
           加载页遮罩颜色按当前主题以字面量内联（tokens.css 亦可能未注入）。 */
        function criticalRules(mode) {
          var splashBg = mode === 'dark' ? '#111a20' : '#f8fbfc';
          return (
            'html:not([data-theme=dark]) .theme-icon-light{display:flex}' +
            'html:not([data-theme=dark]) .theme-icon-dark{display:none}' +
            'html[data-theme=dark] .theme-icon-light{display:none}' +
            'html[data-theme=dark] .theme-icon-dark{display:flex}' +
            'html.no-js .search-trigger{display:none!important}' +
            'html.splash-on .app-splash{position:fixed;inset:0;z-index:90;display:grid;place-items:center;background-color:' +
            splashBg +
            '}'
          );
        }

        function applyTheme() {
          var mode = resolveMode();
          var root = document.documentElement;
          root.classList.remove('no-js');
          root.classList.toggle('dark', mode === 'dark');
          root.dataset.theme = mode;
          root.style.colorScheme = mode;
          var MIRROR_ID = 'cove-critical-rules';
          var style = document.getElementById(MIRROR_ID);
          if (!style) {
            style = document.createElement('style');
            style.id = MIRROR_ID;
            document.head.appendChild(style);
          }
          style.textContent = criticalRules(mode);
        }

        applyTheme();

        /* 换页后重放：监听器挂 document（跨换页存活），window 标记防重复注册 */
        if (!window.__coveThemeBound) {
          window.__coveThemeBound = true;
          document.addEventListener('astro:after-swap', applyTheme);
        }
      })();
    </script>
  </head>
  <body>
    <AppSplash />
    <a class="skip-link" href="#main-content">跳到主要内容</a>
    <SiteHeader />
    <main id="main-content" tabindex="-1">
      <slot />
    </main>
    <SiteFooter />
    <RouteProgress />
  </body>
</html>
