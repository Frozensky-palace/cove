---
/**
 * 文章元信息行：分类、日期、可选更新时间、阅读时长。
 * 阅读时长为构建期派生数据（指南 11.1）。
 */
import { categoryLabel } from '@/data/taxonomy';
import { categoryUrl } from '@/lib/urls';
import { formatDate, readingMinutes, type Post } from '@/lib/content';

interface Props {
  post: Post;
  /** 显示更新时间 */
  showUpdated?: boolean;
  /** 输出 Pagefind 元数据（仅详情页开启；列表页不进索引） */
  pagefind?: boolean;
}

const { post, showUpdated = true, pagefind = false } = Astro.props;
const minutes = readingMinutes(post.body ?? '');
---

<p class="post-meta">
  <a
    class="meta-category"
    href={categoryUrl(post.data.category)}
    {...(pagefind ? { 'data-pagefind-filter': '分类' } : {})}
  >
    {categoryLabel(post.data.category)}
  </a>
  <time
    datetime={post.data.publishedAt}
    {...(pagefind ? { 'data-pagefind-meta': 'date' } : {})}
  >
    {formatDate(post.data.publishedAt)}
  </time>
  {
    showUpdated && post.data.updatedAt && (
      <>
        <span aria-hidden="true">·</span>
        <span>
          更新于 <time datetime={post.data.updatedAt}>{formatDate(post.data.updatedAt)}</time>
        </span>
      </>
    )
  }
  <span aria-hidden="true">·</span>
  <span>{minutes} 分钟阅读</span>
</p>

<style>
  .post-meta {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.375rem 0.625rem;
    color: var(--text-muted);
    font-size: 0.875rem;
  }

  .meta-category {
    color: var(--cove-blue-strong);
    font-weight: 600;
    text-decoration-line: underline;
    text-underline-offset: 0.3em;
    text-decoration-thickness: 1px;
  }

  .meta-category:hover {
    text-decoration-thickness: 2px;
  }
</style>
