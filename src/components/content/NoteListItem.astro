---
/**
 * 笔记列表项（指南 9.5）：视觉重量低于文章；
 * 无标题笔记用日期 + 正文开头代替标题。
 */
import TagList from '@/components/content/TagList.astro';
import { noteUrl } from '@/lib/urls';
import { authorName } from '@/data/authors';
import { formatDate, type Note } from '@/lib/content';

interface Props {
  note: Note;
}

const { note } = Astro.props;
const excerpt = (note.body ?? '').replace(/[#*`>\-[\]]/g, '').trim().slice(0, 80);
const displayTitle = note.data.title ?? `${formatDate(note.data.publishedAt)} 的笔记`;
---

<article class="note-item">
  <div class="note-heading">
    <h3 class="note-title">
      <a href={noteUrl(note.id)}>{displayTitle}</a>
    </h3>
    <span class="note-aside">
      <span class="note-author">{authorName(note.data.author)}</span>
      <time class="note-date" datetime={note.data.publishedAt}>
        {formatDate(note.data.publishedAt)}
      </time>
    </span>
  </div>
  {
    note.data.title && (
      <p class="note-excerpt">{excerpt}</p>
    )
  }
  {note.data.tags.length > 0 && <TagList tags={note.data.tags} max={3} />}
</article>

<style>
  .note-item {
    display: flex;
    flex-direction: column;
    gap: 0.5rem;
    padding-block: 1.25rem;
    /* 负外边距 + 内边距对称扩展：悬停底色出血而不改变排版位置 */
    padding-inline: 0.625rem;
    margin-inline: -0.625rem;
    border-radius: var(--radius-control);
    transition: background-color var(--motion-fast) ease;
  }

  .note-item + .note-item {
    border-top: 1px dashed var(--border);
  }

  /* 悬停：品牌色淡底（指南 8.6：仅颜色变化，无位移）。
     键盘路径同款整行反馈（评审 V04），说明同 ArticleListItem */
  .note-item:hover,
  .note-item:has(:focus-visible) {
    background-color: color-mix(in srgb, var(--cove-blue) 6%, transparent);
  }

  .note-heading {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    justify-content: space-between;
    gap: 0.5rem 1rem;
  }

  .note-title {
    font-size: 1.0625rem;
    font-weight: 600;
    line-height: 1.5;
  }

  .note-title a {
    color: var(--text);
    text-decoration-line: none;
  }

  .note-title a:hover {
    color: var(--cove-blue-strong);
    text-decoration-line: underline;
    text-underline-offset: 0.3em;
  }

  .note-aside {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
  }

  /* 值守者名（IMPL-052）：纯文字，不带头像（用户决策） */
  .note-author {
    color: var(--text-muted);
    font-size: 0.8125rem;
    white-space: nowrap;
  }

  .note-date {
    color: var(--text-muted);
    font-size: 0.8125rem;
    white-space: nowrap;
  }

  .note-excerpt {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.9rem;
    line-height: 1.75;
  }
</style>
