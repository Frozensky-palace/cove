---
/**
 * 上一篇 / 下一篇导航（指南 9.4）。
 */
import { postUrl } from '@/lib/urls';
import type { Post } from '@/lib/content';

interface Props {
  prev?: Post;
  next?: Post;
}

const { prev, next } = Astro.props;
---

{
  (prev || next) && (
    <nav class="prev-next" aria-label="上一篇文章与下一篇文章">
      {prev ? (
        <a class="pn-link pn-prev" href={postUrl(prev.id)} rel="prev">
          <span class="pn-label">上一篇</span>
          <span class="pn-title">{prev.data.title}</span>
        </a>
      ) : (
        <span class="pn-link pn-placeholder" aria-hidden="true" />
      )}
      {next ? (
        <a class="pn-link pn-next" href={postUrl(next.id)} rel="next">
          <span class="pn-label">下一篇</span>
          <span class="pn-title">{next.data.title}</span>
        </a>
      ) : (
        <a class="pn-link pn-next pn-back" href="/posts/">
          <span class="pn-label">返回</span>
          <span class="pn-title">全部文章</span>
        </a>
      )}
    </nav>
  )
}

<style>
  .prev-next {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1rem;
    margin-top: 2.5rem;
  }

  .pn-link {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    padding: 1rem 1.25rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    text-decoration-line: none;
    transition: border-color 120ms ease;
  }

  .pn-link:hover {
    border-color: color-mix(in srgb, var(--cove-blue-strong) 45%, transparent);
  }

  .pn-next {
    text-align: end;
    align-items: flex-end;
  }

  .pn-placeholder {
    visibility: hidden;
  }

  .pn-label {
    color: var(--text-muted);
    font-size: 0.75rem;
    letter-spacing: 0.08em;
  }

  .pn-title {
    color: var(--cove-blue-strong);
    font-size: 0.9375rem;
    font-weight: 600;
    line-height: 1.5;
  }

  @media (max-width: 640px) {
    .prev-next {
      grid-template-columns: 1fr;
    }

    .pn-next {
      text-align: start;
      align-items: flex-start;
    }
  }
</style>
