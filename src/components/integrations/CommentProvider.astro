---
/**
 * CommentProvider（指南 10 边界组件表、19 Phase 6）：Giscus 评论边界组件。
 *
 * - 延迟加载：评论区容器进入视口（rootMargin 200px 预热）才注入 giscus
 *   脚本（指南 8.6：评论区进入视口后加载）；
 * - 失败占位：脚本加载失败（onerror）或超时未见 iframe 时显示占位提示，
 *   正文与导航不受影响（指南 3.5、19 Phase 6 验收「阻止 Giscus 后正文
 *   不受影响」），并提供重试按钮；
 * - 主题同步：MutationObserver 观察 `<html data-theme>`（IMPL-011 的两态
 *   主题机制），变化时向 giscus iframe postMessage setConfig；深色用
 *   transparent_dark 让 iframe 背景透明，与站点背景无缝（见
 *   giscusTheme 注释）；
 * - pathname 映射：URL 即讨论标识（指南 19 Phase 6）。
 *
 * 配置见 src/data/integrations.ts；四项 Giscus 标识任一为空则整块不渲染。
 * 挂载：ArticleLayout（仅文章详情页，指南 9.4 / 6.1）、about 页「留言板」
 * 区块（IMPL-057 由独立 /guestbook/ 页收敛而来，title="留言" 复用同一组件）。
 */
import { giscusConfig } from '@/data/integrations';
import { siteConfig } from '@/data/site';

interface Props {
  /** 区块标题（文章页默认「评论」；about 留言区块传「留言」） */
  title?: string;
  /** 无障碍区块名，默认与 title 一致 */
  ariaLabel?: string;
}

const { title = '评论', ariaLabel = title } = Astro.props;
const { repo, repoId, category, categoryId } = giscusConfig;
const enabled = Boolean(repo && repoId && category && categoryId);

/** 失败占位中的直接反馈入口（评审 F02：不让读者去页脚找联系方式） */
const feedbackEmail = siteConfig.social.find((entry) => entry.href.startsWith('mailto:'))?.href;
---

{
  enabled && (
    <section class="comments" aria-label={ariaLabel} data-pagefind-ignore>
      <h2 class="comments-title">{title}</h2>
      <div class="comments-host" data-comments-host>
        <p class="comments-loading">{title}加载中……</p>
        <p class="comments-fallback" data-comments-fallback hidden>
          {title}区加载失败或被浏览器扩展拦截，阅读不受影响。可
          <button type="button" class="comments-retry" data-comments-retry>
            重试加载
          </button>；如想直接反馈，
          {feedbackEmail ? (
            <a href={feedbackEmail}>给我写邮件</a>
          ) : (
            <span>可通过页脚的联系方式找到我</span>
          )}
          。
        </p>
        <noscript>
          <p class="comments-fallback">{title}区需要 JavaScript；此时阅读不受影响。</p>
        </noscript>
      </div>
    </section>
  )
}

<style>
  .comments {
    max-width: 45rem;
    margin-inline: auto;
    margin-top: 2.5rem;
  }

  .comments-title {
    margin: 0 0 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
    font-size: 1.25rem;
    font-weight: 700;
  }

  .comments-loading,
  .comments-fallback {
    margin: 0;
    color: var(--text-muted);
    font-size: 0.875rem;
    line-height: 1.8;
  }

  /* 加载中：预留与评论框相当的上下留白，避免 iframe 注入时页面尾部
     骤然撑开（布局跳动）；透明度脉动属功能性加载指示（指南 8.6 受限
     例外，IMPL-017 先例），reduced-motion 下由全局规则退化为静态。 */
  .comments-loading {
    padding-block: 5.5rem;
    text-align: center;
    animation: comments-pulse 1.6s ease-in-out infinite;
  }

  @keyframes comments-pulse {
    0%,
    100% {
      opacity: 1;
    }
    50% {
      opacity: 0.45;
    }
  }

  /* 失败/无 JS 占位：与全站空状态语言一致（居中、留白），虚线边框
     表达「占位」语义（虚线先例：系列卡展开分隔线）。 */
  .comments-fallback {
    padding: 1.5rem 1.25rem;
    border: 1px dashed var(--border);
    border-radius: var(--radius-control);
    text-align: center;
  }

  .comments-retry,
  .comments-fallback a {
    padding: 0;
    border: none;
    background: none;
    color: var(--cove-blue-strong);
    font: inherit;
    text-decoration-line: underline;
    text-underline-offset: 0.25em;
    cursor: pointer;
  }
</style>

<script>
  /**
   * ClientRouter 环境（IMPL-017）：挂 astro:page-load，首次加载与每次
   * 换页后执行；评论 host 随页面内容整体替换，按元素幂等守卫。
   *
   * 评审 F02 整改：以 loading/ready/error 显式状态取代「脚本存在」判断——
   * 失败后重试会清除旧脚本、旧 iframe 与旧计时器后重新注入，真正发起新
   * 请求；成功判定只认 giscus iframe。离开页面（host 脱离文档）时轮询
   * 自停；换页重绑时断开上一页的主题观察器（D12 生命周期的一部分）。
   */
  import { giscusConfig } from '@/data/integrations';

  const GISCUS_ORIGIN = 'https://giscus.app';
  /** 脚本注入后等待 iframe 出现的超时；被拦截时以此兜底显示占位 */
  const IFRAME_TIMEOUT_MS = 10_000;

  /** 同一时刻页面只有一个评论 host；换页重绑时断开上一页的观察器 */
  let activeThemeObserver: MutationObserver | null = null;

  function giscusTheme(): string {
    // transparent_dark：iframe 背景透明，页面深色背景透出——giscus 内置
    // dark 主题是 GitHub 深色（#0d1117），与站点 --background（#111a20）
    // 存在可见色差；透明方案两种主题下都与页面无缝。
    return document.documentElement.dataset.theme === 'dark' ? 'transparent_dark' : 'light';
  }

  function setupComments(): void {
    const host = document.querySelector<HTMLElement>('[data-comments-host]');
    if (!host || host.dataset.commentsBound === 'true') return;
    host.dataset.commentsBound = 'true';
    const fallback = host.querySelector<HTMLElement>('[data-comments-fallback]');
    const loading = host.querySelector<HTMLElement>('.comments-loading');

    let pollTimer = 0;
    let timeoutTimer = 0;

    const clearTimers = (): void => {
      window.clearInterval(pollTimer);
      window.clearTimeout(timeoutTimer);
      pollTimer = 0;
      timeoutTimer = 0;
    };

    const setState = (state: 'loading' | 'ready' | 'error'): void => {
      loading?.toggleAttribute('hidden', state !== 'loading');
      fallback?.toggleAttribute('hidden', state !== 'error');
    };

    /** 重试前清理失败残留：旧脚本、旧 iframe、旧计时器（评审 F02） */
    const clearFailedAttempt = (): void => {
      clearTimers();
      host.querySelector('script[data-giscus-script]')?.remove();
      host.querySelectorAll('iframe.giscus-frame').forEach((frame) => frame.remove());
    };

    /** 主题同步：向既有 iframe 转发当前主题（iframe 未就绪时静默跳过） */
    const postTheme = () => {
      const frame = host.querySelector<HTMLIFrameElement>('iframe.giscus-frame');
      frame?.contentWindow?.postMessage(
        { giscus: { setConfig: { theme: giscusTheme() } } },
        GISCUS_ORIGIN,
      );
    };

    activeThemeObserver?.disconnect();
    const themeObserver = new MutationObserver(postTheme);
    themeObserver.observe(document.documentElement, {
      attributes: true,
      attributeFilter: ['data-theme'],
    });
    activeThemeObserver = themeObserver;

    const load = (): void => {
      const script = document.createElement('script');
      script.src = `${GISCUS_ORIGIN}/client.js`;
      script.async = true;
      script.crossOrigin = 'anonymous';
      script.dataset.giscusScript = 'true';
      script.setAttribute('data-repo', giscusConfig.repo);
      script.setAttribute('data-repo-id', giscusConfig.repoId);
      script.setAttribute('data-category', giscusConfig.category);
      script.setAttribute('data-category-id', giscusConfig.categoryId);
      script.setAttribute('data-mapping', giscusConfig.mapping);
      script.setAttribute('data-strict', '0');
      script.setAttribute('data-reactions-enabled', '1');
      script.setAttribute('data-emit-metadata', '0');
      script.setAttribute('data-input-position', 'top');
      script.setAttribute('data-theme', giscusTheme());
      script.setAttribute('data-lang', giscusConfig.lang);
      script.addEventListener('error', () => setState('error'));
      host.appendChild(script);

      /* 成功判定只认 iframe（脚本存在不是成功——重试总会重新注入） */
      pollTimer = window.setInterval(() => {
        if (!host.isConnected) {
          /* 换页旧 host：停止观察与计时（评审 F02 验收项） */
          clearTimers();
          return;
        }
        const frames = host.querySelectorAll('iframe.giscus-frame');
        if (frames.length > 0) {
          /* 防御重复注入：只保留第一个评论框 */
          frames.forEach((frame, index) => {
            if (index > 0) frame.remove();
          });
          clearTimers();
          setState('ready');
        }
      }, 500);
      timeoutTimer = window.setTimeout(() => {
        if (host.isConnected && !host.querySelector('iframe.giscus-frame')) setState('error');
      }, IFRAME_TIMEOUT_MS);
    };

    host.querySelector('[data-comments-retry]')?.addEventListener('click', () => {
      clearFailedAttempt();
      setState('loading');
      load();
    });

    const observer = new IntersectionObserver(
      (entries) => {
        if (entries.some((entry) => entry.isIntersecting)) {
          observer.disconnect();
          load();
        }
      },
      { rootMargin: '200px 0px' },
    );
    observer.observe(host);
  }

  document.addEventListener('astro:page-load', setupComments);
</script>
