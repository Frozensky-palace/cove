---
/**
 * Cove 标志：灯塔、光束与海湾曲线。
 * 完整品牌图标使用 cove-icon.svg；浏览器标签页另用透明 favicon.svg。
 */
interface Props {
  /** 图形尺寸（px），常用 20/24 */
  size?: number;
  /** 是否携带 Cove 字标 */
  wordmark?: boolean;
}

const { size = 24, wordmark = true } = Astro.props;
---

<span class="logo">
  <img
    src="/cove-icon.svg"
    alt=""
    width={size}
    height={size}
    aria-hidden="true"
    class="logo-mark"
  />
  {wordmark && <span class="logo-word">Cove</span>}
</span>

<style>
  .logo {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    line-height: 1;
  }

  .logo-mark {
    display: block;
    flex-shrink: 0;
  }

  .logo-word {
    font-size: 1.25rem;
    font-weight: 700;
    letter-spacing: 0.02em;
    color: var(--text);
  }
</style>
