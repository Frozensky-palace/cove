---
/**
 * 全局页头（指南 9.1）：标志、一级导航、搜索入口与主题按钮。
 * 桌面高度 64px，吸顶 + 实色背景；当前页以细线与文字色表达。
 * 窄屏（≤899px）：原生链接隐藏，MobileNav（Vue Sheet，client:media）接管；
 * JS 不可用时（html.no-js）回退为可换行的原生链接列表（渐进增强，IMPL-009）。
 */
import Logo from '@/components/base/Logo.astro';
import ThemeToggle from '@/components/base/ThemeToggle.astro';
import SearchIcon from '@/components/base/icons/SearchIcon.astro';
import MobileNav from '@/components/islands/MobileNav.vue';
import SearchDialog from '@/components/islands/SearchDialog.vue';
import { siteConfig } from '@/data/site';

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';

function isActive(href: string): boolean {
  const target = href.replace(/\/+$/, '') || '/';
  if (target === '/') return currentPath === '/';
  return currentPath === target || currentPath.startsWith(`${target}/`);
}

const mobileNavItems = siteConfig.nav.map((item) => ({
  ...item,
  current: isActive(item.href),
}));
---

<header class="site-header">
  <div class="cove-container header-inner">
    <a class="brand" href="/" aria-label="Cove，返回首页">
      <Logo size={24} />
    </a>

    <nav class="main-nav" aria-label="主导航">
      <ul>
        {
          siteConfig.nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="nav-link"
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      {/* 搜索对话框（IMPL-008 落地）：client:idle 水合，Ctrl/Cmd+K 与 / 唤起 */}
      <SearchDialog client:idle />
      {/* JS 不可用时的降级入口：直达 /search/ 完整页 */}
      <a class="search-entry search-fallback" href="/search/" aria-label="搜索（前往搜索页）">
        <SearchIcon size={18} />
        <span aria-hidden="true">搜索</span>
      </a>
      <ThemeToggle />
      <MobileNav
        client:media="(max-width: 899px)"
        items={mobileNavItems}
        secondary={siteConfig.footerNav.map((item) => ({ ...item }))}
      />
    </div>
  </div>
</header>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--border);
    background-color: var(--background);
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    min-height: 64px;
    padding-block: 0.25rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.5rem 0.375rem 0;
    border-radius: var(--radius-control);
  }

  .main-nav ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 0.75rem;
    border-radius: var(--radius-control);
    color: var(--text-muted);
    font-size: 15px;
    text-decoration: none;
    transition:
      color 150ms ease,
      background-color 150ms ease;
  }

  .nav-link:hover {
    color: var(--text);
  }

  /* 当前页：文字色 + 品牌色细线（指南 9.1，不用大胶囊底色） */
  .nav-link[aria-current='page'] {
    color: var(--text);
    font-weight: 600;
    text-decoration-line: underline;
    text-decoration-color: var(--cove-blue-strong);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.5em;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.25rem;
  }

  .search-entry {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 44px;
    padding-inline: 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    background-color: var(--surface);
    color: var(--text-muted);
    font-size: 14px;
    text-decoration: none;
    transition:
      color 150ms ease,
      border-color 150ms ease;
  }

  .search-entry:hover {
    color: var(--text);
    border-color: color-mix(in srgb, var(--cove-blue-strong) 45%, transparent);
  }

  /* 窄屏交给 MobileNav 岛；仅当 JS 可用（no-js 已被移除）时隐藏原生链接 */
  @media (max-width: 899px) {
    :global(html:not(.no-js)) .main-nav {
      display: none;
    }
  }
</style>

<style is:global>
  /* JS 不可用：隐藏岛屿触发器（点击无响应），保留可换行的原生链接导航与搜索页直达链接 */
  html.no-js .mobile-nav-trigger,
  html.no-js .search-trigger {
    display: none !important;
  }

  .search-fallback {
    display: none;
  }

  html.no-js .search-fallback {
    display: inline-flex;
  }
</style>
