---
/**
 * 全局页头（指南 9.1）：标志、一级导航、搜索入口与主题按钮。
 * 桌面高度 68px（指南区间 64–72px），吸顶 + 实色背景；当前页以细线与文字色表达。
 * 窄屏（≤899px）：原生链接隐藏，MobileNav（Vue Sheet，client:media）接管；
 * JS 不可用时（html.no-js）回退为可换行的原生链接列表（渐进增强，IMPL-009）。
 * IMPL-056（评审报告 4.8）：搜索弹窗不再 client:idle 全站预载——搜索入口
 * 是服务器渲染的普通链接（指向 /search/），首次交互（点击 / Ctrl+K / “/”）
 * 才动态挂载 Vue 弹窗；无 JS 环境链接原样可用，是完整的渐进增强。
 */
import Logo from '@/components/base/Logo.astro';
import ThemeToggle from '@/components/base/ThemeToggle.astro';
import SearchIcon from '@/components/base/icons/SearchIcon.astro';
import MobileNav from '@/components/islands/MobileNav.vue';
import { siteConfig } from '@/data/site';

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';

function isActive(href: string): boolean {
  const target = href.replace(/\/+$/, '') || '/';
  if (target === '/') return currentPath === '/';
  return currentPath === target || currentPath.startsWith(`${target}/`);
}

const mobileNavItems = siteConfig.nav.map((item) => ({
  ...item,
  current: isActive(item.href),
}));
---

<header class="site-header">
  <div class="cove-container header-inner">
    <a class="brand" href="/" aria-label="Cove，返回首页">
      <Logo size={24} />
    </a>

    <nav class="main-nav" aria-label="主导航">
      <ul>
        {
          siteConfig.nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="nav-link"
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      {/* 搜索入口（IMPL-056 按需加载）：启动前是普通链接（data-search-fallback），
          首次交互后由此脚本动态挂载 SearchDialog 并替换为弹窗触发按钮 */}
      <a
        class="search-entry"
        href="/search/"
        data-search-fallback
        aria-label="搜索（前往搜索页，或按 Ctrl K 唤起）"
      >
        <SearchIcon size={18} />
        <span aria-hidden="true">搜索</span>
      </a>
      <span class="search-host" data-search-host></span>
      <ThemeToggle />
      <MobileNav
        client:media="(max-width: 899px)"
        items={mobileNavItems}
        secondary={siteConfig.footerNav.map((item) => ({ ...item }))}
      />
    </div>
  </div>
</header>

<script>
  /**
   * 搜索弹窗按需启动（IMPL-056；评审 F01/F04 整改）：
   * 「模块已加载」与「实例已挂在当前页 host」是两个独立状态——不能共用
   * 一个布尔值。ClientRouter 换页会整体重建页头 DOM，旧 Vue 实例随旧
   * host 失效：before-swap 时卸载回收监听，page-load 后在新 host 重挂；
   * 动态 import 的模块本身可以缓存复用。模块加载失败（chunk 被拦截、
   * 网络错误）时不再吞掉点击——放行原生导航到 /search/，完整搜索页
   * 不依赖弹窗模块；模块缓存一并清除，下次交互可重试。
   */
  type SearchApp = { unmount: () => void };
  type MountModule = typeof import('@/components/islands/mountSearchDialog');

  let modulePromise: Promise<MountModule> | null = null;
  let app: SearchApp | null = null;
  /** 当前实例挂载的 host；与页面上现存 host 不一致即视为过期 */
  let mountedHost: HTMLElement | null = null;
  /** 并发保护：同一次挂载进行中的 Promise（评审 F01） */
  let mounting: Promise<boolean> | null = null;

  function currentHost(): HTMLElement | null {
    return document.querySelector<HTMLElement>('[data-search-host]');
  }

  function isReady(): boolean {
    const host = currentHost();
    return !!app && !!mountedHost && mountedHost === host;
  }

  /** 确保弹窗已挂在当前页的 host 上；false = 挂载失败（调用方回退导航） */
  function ensureMounted(): Promise<boolean> {
    const host = currentHost();
    if (!host) return Promise.resolve(false);
    if (isReady()) return Promise.resolve(true);

    /* 过期实例（上一页的 host）：立即卸载，回收其 window 监听 */
    app?.unmount();
    app = null;
    mountedHost = null;

    if (!mounting) {
      modulePromise ??= import('@/components/islands/mountSearchDialog');
      mounting = modulePromise
        .then(({ mountSearchDialog }) => {
          /* import 期间可能又发生换页：以解析时刻的 host 为准 */
          const target = currentHost();
          if (!target) return false;
          app = mountSearchDialog(target);
          mountedHost = target;
          document.querySelector('[data-search-fallback]')?.remove();
          return true;
        })
        .catch(() => {
          /* 失败不缓存模块 Promise：下次交互重新加载（评审 F04） */
          modulePromise = null;
          return false;
        })
        .finally(() => {
          mounting = null;
        });
    }
    return mounting;
  }

  /** 挂载成功即打开弹窗；失败回退为普通导航到 /search/ */
  function openOrNavigate(fallbackHref: string): void {
    void ensureMounted().then((ok) => {
      if (ok) window.dispatchEvent(new CustomEvent('cove:search-open'));
      else window.location.assign(fallbackHref);
    });
  }

  function isTyping(target: EventTarget | null): boolean {
    const el = target as HTMLElement | null;
    return !!el && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.isContentEditable);
  }

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    const entry = target?.closest?.('a[data-search-fallback]');
    if (!entry || event.defaultPrevented) return;
    /* 保留修饰键点击的原生行为（新标签页、下载等） */
    if (event.button !== 0 || event.metaKey || event.ctrlKey || event.shiftKey || event.altKey) {
      return;
    }
    event.preventDefault();
    openOrNavigate(entry.getAttribute('href') ?? '/search/');
  });

  document.addEventListener('keydown', (event) => {
    /* 已挂在当前页：Ctrl/Cmd+K 与 “/” 由 SearchDialog 自身处理（含再按关闭） */
    if (isReady()) return;
    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      openOrNavigate('/search/');
    } else if (event.key === '/' && !isTyping(event.target)) {
      event.preventDefault();
      openOrNavigate('/search/');
    }
  });

  /* ClientRouter 生命周期（评审 F01）：页面交换前卸载旧实例——旧 host
     随旧文档废弃，卸载回收 window 监听；新页面在 page-load 后按需重挂。
     仅当模块此前已加载（用户用过搜索，modulePromise 非空）才自动重挂，
     保持 IMPL-056 的按需启动：未用过搜索的页面仍是指向 /search/ 的
     普通链接，不随换页预载 Vue chunk。加载失败的 chunk 已清除缓存，
     同样保持按需，由下次交互重试。 */
  document.addEventListener('astro:before-swap', () => {
    app?.unmount();
    app = null;
    mountedHost = null;
  });

  document.addEventListener('astro:page-load', () => {
    if (modulePromise) void ensureMounted();
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--border);
    background-color: var(--background);
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    min-height: 68px;
    padding-block: 0.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.5rem 0.375rem 0;
    border-radius: var(--radius-control);
  }

  .main-nav ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 1rem;
    border-radius: var(--radius-control);
    color: var(--text-muted);
    font-size: 15px;
    text-decoration: none;
    transition:
      color var(--motion-fast) ease,
      background-color var(--motion-fast) ease;
  }

  .nav-link:hover {
    color: var(--text);
  }

  /* 当前页：文字色 + 品牌色细线（指南 9.1，不用大胶囊底色） */
  .nav-link[aria-current='page'] {
    color: var(--text);
    font-weight: 600;
    text-decoration-line: underline;
    text-decoration-color: var(--cove-blue-strong);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.5em;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* 搜索弹窗挂载点：不参与布局，Vue 触发按钮直接与相邻元素并排 */
  .search-host {
    display: contents;
  }

  .search-entry {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 44px;
    padding-inline: 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    background-color: var(--surface);
    color: var(--text-muted);
    font-size: 14px;
    text-decoration: none;
    transition:
      color var(--motion-fast) ease,
      border-color var(--motion-fast) ease;
  }

  .search-entry:hover {
    color: var(--text);
    border-color: color-mix(in srgb, var(--cove-blue-strong) 45%, transparent);
  }

  /* 窄屏交给 MobileNav 岛：仅当岛屿成功挂载（html.mobile-nav-ready，
     MobileNav onMounted 添加）时隐藏原生链接——覆盖「JS 可执行但岛屿
     未就绪/加载失败」的中间态，期间原生导航始终可用（评审 D08） */
  @media (max-width: 899px) {
    :global(html.mobile-nav-ready) .main-nav {
      display: none;
    }
  }

  /* 评审 L01：320px 级窄屏页头保持单行——隐藏搜索入口的可见文字
     （aria-label 保留完整语义），并收紧容器与操作区间距 */
  @media (max-width: 479px) {
    .header-inner {
      gap: 0.5rem;
    }

    .header-actions {
      gap: 0.375rem;
    }

    .search-entry {
      padding-inline: 0.625rem;
    }

    .search-entry span {
      display: none;
    }
  }
</style>

<style is:global>
  /* JS 不可用：隐藏移动端岛屿触发器（点击无响应），保留可换行的原生链接导航；
      搜索入口本就是服务器渲染的普通链接（IMPL-056），无需按 JS 状态切换 */
  html.no-js .mobile-nav-trigger {
    display: none !important;
  }
</style>
