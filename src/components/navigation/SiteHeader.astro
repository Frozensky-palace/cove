---
/**
 * 全局页头（指南 9.1）：标志、一级导航、搜索入口与主题按钮。
 * 桌面高度 68px（指南区间 64–72px），吸顶 + 实色背景；当前页以细线与文字色表达。
 * 窄屏（≤899px）：原生链接隐藏，MobileNav（Vue Sheet，client:media）接管；
 * JS 不可用时（html.no-js）回退为可换行的原生链接列表（渐进增强，IMPL-009）。
 * IMPL-056（评审报告 4.8）：搜索弹窗不再 client:idle 全站预载——搜索入口
 * 是服务器渲染的普通链接（指向 /search/），首次交互（点击 / Ctrl+K / “/”）
 * 才动态挂载 Vue 弹窗；无 JS 环境链接原样可用，是完整的渐进增强。
 */
import Logo from '@/components/base/Logo.astro';
import ThemeToggle from '@/components/base/ThemeToggle.astro';
import SearchIcon from '@/components/base/icons/SearchIcon.astro';
import MobileNav from '@/components/islands/MobileNav.vue';
import { siteConfig } from '@/data/site';

const currentPath = Astro.url.pathname.replace(/\/+$/, '') || '/';

function isActive(href: string): boolean {
  const target = href.replace(/\/+$/, '') || '/';
  if (target === '/') return currentPath === '/';
  return currentPath === target || currentPath.startsWith(`${target}/`);
}

const mobileNavItems = siteConfig.nav.map((item) => ({
  ...item,
  current: isActive(item.href),
}));
---

<header class="site-header">
  <div class="cove-container header-inner">
    <a class="brand" href="/" aria-label="Cove，返回首页">
      <Logo size={24} />
    </a>

    <nav class="main-nav" aria-label="主导航">
      <ul>
        {
          siteConfig.nav.map((item) => (
            <li>
              <a
                href={item.href}
                class="nav-link"
                aria-current={isActive(item.href) ? 'page' : undefined}
              >
                {item.label}
              </a>
            </li>
          ))
        }
      </ul>
    </nav>

    <div class="header-actions">
      {/* 搜索入口（IMPL-056 按需加载）：启动前是普通链接（data-search-fallback），
          首次交互后由此脚本动态挂载 SearchDialog 并替换为弹窗触发按钮 */}
      <a
        class="search-entry"
        href="/search/"
        data-search-fallback
        aria-label="搜索（前往搜索页，或按 Ctrl K 唤起）"
      >
        <SearchIcon size={18} />
        <span aria-hidden="true">搜索</span>
      </a>
      <span class="search-host" data-search-host></span>
      <ThemeToggle />
      <MobileNav
        client:media="(max-width: 899px)"
        items={mobileNavItems}
        secondary={siteConfig.footerNav.map((item) => ({ ...item }))}
      />
    </div>
  </div>
</header>

<script>
  /**
   * 搜索弹窗按需启动（IMPL-056，评审报告 4.8）：Vue/Reka 运行时不再随
   * 首屏（原 client:idle）加载；首次交互（点击搜索入口、Ctrl/Cmd+K、“/”）
   * 才动态 import 挂载模块。启动前入口是指向 /search/ 的普通链接——
   * 无 JS 与「启动前」两个阶段都完整可用。已启动后快捷键与开合由
   * SearchDialog 自身的 keydown 处理（含 Ctrl+K 再按关闭）。
   */
  let booted = false;
  let app: { unmount: () => void } | null = null;

  async function boot(openNow: boolean): Promise<void> {
    if (booted) {
      if (openNow) window.dispatchEvent(new CustomEvent('cove:search-open'));
      return;
    }
    const host = document.querySelector<HTMLElement>('[data-search-host]');
    if (!host) return;
    booted = true;
    /* ClientRouter 换页重挂载时清掉旧实例，避免泄漏 window 监听 */
    app?.unmount();
    const { mountSearchDialog } = await import('@/components/islands/mountSearchDialog');
    app = mountSearchDialog(host);
    document.querySelector('[data-search-fallback]')?.remove();
    if (openNow) window.dispatchEvent(new CustomEvent('cove:search-open'));
  }

  function isTyping(target: EventTarget | null): boolean {
    const el = target as HTMLElement | null;
    return !!el && (el.tagName === 'INPUT' || el.tagName === 'TEXTAREA' || el.isContentEditable);
  }

  document.addEventListener('click', (event) => {
    const target = event.target as HTMLElement | null;
    if (target?.closest?.('[data-search-fallback]')) {
      event.preventDefault();
      void boot(true);
    }
  });

  document.addEventListener('keydown', (event) => {
    if (booted) return;
    if ((event.ctrlKey || event.metaKey) && event.key.toLowerCase() === 'k') {
      event.preventDefault();
      void boot(true);
    } else if (event.key === '/' && !isTyping(event.target)) {
      event.preventDefault();
      void boot(true);
    }
  });

  /* ClientRouter 换页：header 整体重建，已启动过则在新的 host 上重挂载 */
  document.addEventListener('astro:page-load', () => {
    if (booted) void boot(false);
  });
</script>

<style>
  .site-header {
    position: sticky;
    top: 0;
    z-index: 50;
    border-bottom: 1px solid var(--border);
    background-color: var(--background);
  }

  .header-inner {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    justify-content: space-between;
    gap: 0.5rem 1rem;
    min-height: 68px;
    padding-block: 0.5rem;
  }

  .brand {
    display: inline-flex;
    align-items: center;
    padding: 0.375rem 0.5rem 0.375rem 0;
    border-radius: var(--radius-control);
  }

  .main-nav ul {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.75rem;
    list-style: none;
    margin: 0;
    padding: 0;
  }

  .nav-link {
    display: inline-flex;
    align-items: center;
    min-height: 44px;
    padding-inline: 1rem;
    border-radius: var(--radius-control);
    color: var(--text-muted);
    font-size: 15px;
    text-decoration: none;
    transition:
      color 150ms ease,
      background-color 150ms ease;
  }

  .nav-link:hover {
    color: var(--text);
  }

  /* 当前页：文字色 + 品牌色细线（指南 9.1，不用大胶囊底色） */
  .nav-link[aria-current='page'] {
    color: var(--text);
    font-weight: 600;
    text-decoration-line: underline;
    text-decoration-color: var(--cove-blue-strong);
    text-decoration-thickness: 2px;
    text-underline-offset: 0.5em;
  }

  .header-actions {
    display: flex;
    align-items: center;
    gap: 0.5rem;
  }

  /* 搜索弹窗挂载点：不参与布局，Vue 触发按钮直接与相邻元素并排 */
  .search-host {
    display: contents;
  }

  .search-entry {
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    height: 44px;
    padding-inline: 0.75rem;
    border: 1px solid var(--border);
    border-radius: var(--radius-control);
    background-color: var(--surface);
    color: var(--text-muted);
    font-size: 14px;
    text-decoration: none;
    transition:
      color 150ms ease,
      border-color 150ms ease;
  }

  .search-entry:hover {
    color: var(--text);
    border-color: color-mix(in srgb, var(--cove-blue-strong) 45%, transparent);
  }

  /* 窄屏交给 MobileNav 岛；仅当 JS 可用（no-js 已被移除）时隐藏原生链接 */
  @media (max-width: 899px) {
    :global(html:not(.no-js)) .main-nav {
      display: none;
    }
  }
</style>

<style is:global>
  /* JS 不可用：隐藏移动端岛屿触发器（点击无响应），保留可换行的原生链接导航；
      搜索入口本就是服务器渲染的普通链接（IMPL-056），无需按 JS 状态切换 */
  html.no-js .mobile-nav-trigger {
    display: none !important;
  }
</style>
