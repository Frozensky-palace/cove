---
/**
 * 全局页脚：站点信息、主导航入口、内容发现入口与版权。
 * 分类/标签/归档/RSS 在页脚提供入口（指南 7.1）。
 */
import Logo from '@/components/base/Logo.astro';
import { siteConfig } from '@/data/site';

const year = new Date().getFullYear();
---

<footer class="site-footer">
  <div class="cove-container footer-inner">
    <div class="footer-brand">
      <Logo size={22} />
      <p class="footer-tagline">{siteConfig.tagline}</p>
      <p class="footer-copy">
        © {year} {siteConfig.name}
        {siteConfig.author.name && ` · ${siteConfig.author.name}`}
      </p>
    </div>

    <nav class="footer-nav" aria-label="页脚导航">
      <div>
        <h2 class="footer-heading">导航</h2>
        <ul>
          {
            siteConfig.nav.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </div>

      <div>
        <h2 class="footer-heading">发现与订阅</h2>
        <ul>
          {
            siteConfig.footerNav.map((item) => (
              <li>
                <a href={item.href}>{item.label}</a>
              </li>
            ))
          }
        </ul>
      </div>
    </nav>
  </div>
</footer>

<style>
  .site-footer {
    border-top: 1px solid var(--border);
    background-color: var(--surface-muted);
    margin-top: 4rem;
  }

  .footer-inner {
    display: flex;
    flex-wrap: wrap;
    justify-content: space-between;
    gap: 2rem 3rem;
    padding-block: 2.5rem;
  }

  .footer-brand {
    max-width: 26rem;
  }

  .footer-tagline {
    margin-top: 0.75rem;
    color: var(--text);
    font-size: 14px;
  }

  .footer-copy {
    margin-top: 0.5rem;
    color: var(--text-muted);
    font-size: 13px;
  }

  .footer-nav {
    display: flex;
    flex-wrap: wrap;
    gap: 2rem 3.5rem;
  }

  .footer-heading {
    margin: 0 0 0.75rem;
    color: var(--text-muted);
    font-size: 12px;
    font-weight: 600;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .footer-nav ul {
    list-style: none;
    margin: 0;
    padding: 0;
    display: grid;
    gap: 0.375rem;
  }

  .footer-nav a {
    color: var(--text-muted);
    font-size: 14px;
    text-decoration: none;
    transition: color 150ms ease;
  }

  .footer-nav a:hover {
    color: var(--cove-blue-strong);
    text-decoration-line: underline;
    text-underline-offset: 0.3em;
  }
</style>
