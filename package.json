{
  "name": "cove",
  "type": "module",
  "version": "0.1.0",
  "private": true,
  "description": "Cove 个人博客与内容空间（Astro 静态站点）",
  "packageManager": "pnpm@10.20.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "astro dev",
    "check": "astro check",
    "build:site": "astro build",
    "build:search": "pagefind --site dist",
    "build": "astro check && node scripts/content-guard.mjs && astro build && node scripts/generate-og-images.mjs && pagefind --site dist && node scripts/noindex-preview.mjs && node scripts/dist-guard.mjs && node scripts/link-check.mjs",
    "preview": "astro preview",
    "guard:content": "node scripts/content-guard.mjs",
    "guard:dist": "node scripts/dist-guard.mjs",
    "guard:links": "node scripts/link-check.mjs",
    "sync": "astro sync"
  },
  "dependencies": {
    "@astrojs/markdown-remark": "^7.3.1",
    "@astrojs/rss": "^4.0.19",
    "@astrojs/sitemap": "^3.7.4",
    "@astrojs/vue": "^7.0.2",
    "@lucide/vue": "^1.46.0",
    "astro": "^7.3.2",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-slug": "^6.0.0",
    "reka-ui": "^2.10.4",
    "tailwind-merge": "^3.7.0",
    "vue": "^3.5.42",
    "zod": "^4.6.5"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild",
      "sharp"
    ]
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@fontsource/noto-sans-sc": "^5.3.0",
    "@resvg/resvg-js": "^2.6.2",
    "@tailwindcss/vite": "^4.3.3",
    "@types/hast": "^3.0.5",
    "gray-matter": "^4.0.3",
    "pagefind": "^1.5.2",
    "satori": "^0.33.5",
    "sharp": "^0.35.4",
    "tailwindcss": "^4.3.3",
    "tw-animate-css": "^1.4.0",
    "typescript": "^6.0.3",
    "unist-util-visit": "^5.1.0"
  }
}
